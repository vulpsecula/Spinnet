    "%@ left the front while the text was typed. Only part of it was inserted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入文本期间 %@ 离开了前台。只插入了其中一部分。"
