    "Its App Overrides for %@ are removed with it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它在 %@ 中的 App 覆盖也会一并移除。"
          }
        }
      }
    },
    "Its access decisions are kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的访问权限决定会保留。"
          }
        }
      }
    },
    "Its access is forgotten and it leaves the Library.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的访问权限会被遗忘，并离开资源库。"
          }
        }
      }
    },
    "JPEG": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG"
          }
        }
      }
    },
    "JPEG for photos, gradients and noise; PNG for text and flat colours.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片、渐变和噪点用 JPEG；文字和纯色用 PNG。"
          }
        }
      }
    },
    "Just now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刚刚"
          }
        }
      }
    },
    "Keep entries for": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条目保留时长"
          }
        }
      }
    },
    "Keep the Mac and Display Awake": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Mac 和显示器保持唤醒"
          }
        }
      }
    },
    "Keep this view open": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持此视图打开"
          }
        }
      }
    },
    "Keeps the Mac awake until stopped, for a while or while an App runs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Mac 保持唤醒，直到停止、持续一段时间或在某个 App 运行期间。"
          }
        }
      }
    },
