            "value": "更改会自动存储"
          }
        }
      }
    },
    "Changes take effect immediately and apply to all Actions from each Plugin. Access is checked again when an Action runs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改会立即生效，并应用于每个插件的所有动作。动作运行时会再次检查访问权限。"
          }
