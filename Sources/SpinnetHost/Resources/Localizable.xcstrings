        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下快捷键…"
          }
        }
      }
    },
    "Prevent idle system and display sleep while the Host owns an effect. Explicit Sleep, closing the lid and low-battery sleep still apply. Stop any effect from the Spinnet Status Item.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宿主持有效果期间，阻止系统和显示器闲置睡眠。手动睡眠、合上盖子和低电量睡眠仍然有效。可从 Spinnet 菜单栏图标停止任何效果。"
          }
        }
      }
    },
    "Primary Action": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主要动作"
          }
        }
      }
    },
    "Primary Action: %@": {
      "localizations": {
