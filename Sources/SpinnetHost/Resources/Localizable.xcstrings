    },
    "Once a day, ask each Plugin's Update Source for a newer version. Nothing installs by itself.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天一次向每个插件的更新源询问是否有新版本。不会自动安装任何内容。"
          }
        }
      }
    },
    "Only %@'s Menu Item in this Slot is replaced. The default Menu stays unchanged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只替换 %@ 在此槽位中的菜单项。默认菜单保持不变。"
          }
        }
      }
    },
    "Only a Host running from an app bundle can reopen itself.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有从 App 包运行的宿主才能重新打开自己。"
          }
        }
      }
    },
    "Open": {
      "localizations": {
