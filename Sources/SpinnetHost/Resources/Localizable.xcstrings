      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有类型"
          }
        }
      }
    },
    "All eligible Homebrew cache downloads and old package versions may be deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有符合条件的 Homebrew 缓存下载项和旧软件包版本都可能被删除。"
          }
        }
      }
    },
    "Allow %@ to contact %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 %1$@ 联络 %2$@"
          }
        }
      }
    },
    "Allow Spinnet in System Settings → General → Login Items.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“系统设置”→“通用”→“登录项”中允许 Spinnet。"
          }
        }
      }
    },
    "Allow Spinnet in macOS Login Items & Extensions, then return here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 macOS“登录项与扩展”中允许 Spinnet，然后返回此处。"
          }
        }
      }
    },
    "Allow Spinnet to control %@ in macOS Automation settings, then connect again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 macOS 自动化设置中允许 Spinnet 控制 %@，然后再次连接。"
          }
        }
      }
    },
    "Allows Spinnet to perform system changes for Tasks you confirm. macOS may also ask for administrator approval for a specific operation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Spinnet 为你确认的任务执行系统更改。macOS 也可能为特定操作要求管理员批准。"
          }
        }
      }
    },
    "Alternate Action %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备选动作 %@"
          }
        }
      }
    },
    "Alternate Action: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备选动作：%@"
          }
        }
      }
