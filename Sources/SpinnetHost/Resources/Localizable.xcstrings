      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 连接"
          }
        }
      }
    },
    "App Overrides use it in %@; they stay and are marked unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 覆盖在 %@ 中使用了它；它们会保留并标记为不可用。"
