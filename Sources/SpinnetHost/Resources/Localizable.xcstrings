    "Alternate Actions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备选动作"
          }
        }
      }
    },
    "Alternate Ring": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备选环"
          }
        }
      }
    },
    "Any unsaved changes in %@ will be lost.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中任何未存储的更改都将丢失。"
          }
        }
      }
