{
  "sourceLanguage": "en",
  "strings": {
    "Never": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永不"
          }
        }
      }
    },
    "Remove Ended Tasks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除已结束的任务"
          }
        }
      }
    },
    "Automatically clear ended Tasks after this time. History is also limited to make room for new Host Activities.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此时间后自动清除已结束的任务。历史记录也有数量限制，以便为新的宿主活动腾出空间。"
          }
        }
      }
    },
    "After 1 hour": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 小时后"
          }
        }
      }
    },
    "After 1 day": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 天后"
          }
        }
      }
    },
    "After 7 days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天后"
          }
        }
      }
    },
    "When off, the Status Item appears for ongoing Tasks and Effects, and for retained ended Tasks. Open Spinnet again to show Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，菜单栏图标会在有进行中的任务、效果或保留的已结束任务时显示。再次打开 Spinnet 可显示设置。"
          }
        }
      }
    },
    " · Other account": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · 其他账户"
          }
        }
      }
    },
    " — idle sleep prevention unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " — 无法阻止闲置睡眠"
          }
        }
      }
    },
    " — prevents idle system sleep": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " — 阻止系统闲置睡眠"
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@ is installed again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ 已重新安装。"
          }
        }
      }
    },
    "%@ %@ is installed now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在安装的是 %1$@ %2$@。"
          }
        }
      }
    },
    "%@ %@ is installed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ 已安装。"
          }
        }
      }
    },
