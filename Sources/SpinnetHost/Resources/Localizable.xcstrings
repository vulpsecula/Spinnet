      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@页面内容"
          }
        }
      }
    },
    "%@ Some changes could not be restored. Review the saved settings and credentials before retrying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 部分更改无法恢复。重试前请检查已存储的设置和凭据。"
          }
        }
      }
    },
    "%@ accent colour": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@强调色"
          }
        }
      }
    },
    "%@ and %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@和%2$@"
          }
        }
      }
    },
    "%@ application icon": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 应用程序图标"
          }
        }
      }
    },
    "%@ asks Spinnet to close the front window of %@, as its Close menu item (⌘W) does.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 请求 Spinnet 关闭 %2$@ 的前台窗口，与其“关闭”菜单项（⌘W）的效果相同。"
          }
        }
      }
    },
    "%@ asks Spinnet to force quit %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 请求 Spinnet 强制退出 %2$@。"
          }
        }
      }
    },
    "%@ asks Spinnet to quit %@, as its Quit menu item (⌘Q) does.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 请求 Spinnet 退出 %2$@，与其“退出”菜单项（⌘Q）的效果相同。"
          }
        }
      }
    },
    "%@ changed during the check.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在检查期间发生了变化。"
          }
        }
      }
    },
    "%@ completed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已完成"
          }
        }
      }
    },
    "%@ configuration input": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@配置输入"
          }
        }
      }
    },
    "%@ could not be checked: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查 %1$@：%2$@"
          }
        }
      }
    },
    "%@ declares no Update Source.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未声明更新源。"
          }
        }
      }
    },
    "%@ did not come to the front. Nothing was inserted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未切换到前台。未插入任何内容。"
          }
        }
      }
    },
    "%@ does not open %@: links; update %@ or turn on its URL scheme in its settings, then try again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不打开 %2$@: 链接；请更新 %3$@，或在其设置中打开它的 URL 协议，然后重试"
          }
        }
      }
    },
    "%@ files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 个文件"
          }
        }
      }
    },
    "%@ forgets everything it kept for itself. Its settings, access, and Menu Items stay as they are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会忘记为自己保存的一切。它的设置、访问权限和菜单项保持不变。"
          }
        }
      }
    },
    "%@ granted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授予%@"
          }
        }
      }
    },
    "%@ has quit. Nothing was inserted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已退出。未插入任何内容。"
          }
        }
      }
    },
    "%@ installed formula dependencies will be uninstalled. Every candidate is listed below. Stopping does not undo removals.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将卸载 %@ 个已安装的 formula 依赖项。下方列出了每个候选项。停止不会撤销移除。"
          }
        }
      }
    },
    "%@ is loading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在载入"
          }
        }
      }
    },
    "%@ is not in front. Nothing was inserted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在前台。未插入任何内容。"
