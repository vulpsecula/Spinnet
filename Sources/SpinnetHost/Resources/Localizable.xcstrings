    },
    "%@ may ask you to save your changes first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可能会先要求你存储更改。"
          }
        }
      }
    },
    "%@ may monitor %@. Remove that button's click, drag, and scroll assignments in the other utility.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 可能在监视%2$@。请在该工具中移除这个按键的点按、拖移和滚动分配。"
          }
        }
      }
    },
    "%@ must be an https address, such as https://api.example.com.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必须是 https 地址，例如 https://api.example.com。"
