    "Hold the trigger this long to open the Menu. A shorter press goes to the App, so Side Button 1 still goes Back.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住触发键达到此时长才会打开菜单。较短的按压会交给 App，所以侧键 1 仍可返回。"
          }
