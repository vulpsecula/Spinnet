    },
    "Changes take effect immediately and apply to all Actions from this Plugin.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改会立即生效，并应用于此插件的所有动作。"
          }
        }
      }
    },
    "Changes the selected user-owned service at login; this service may continue after Spinnet exits.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
