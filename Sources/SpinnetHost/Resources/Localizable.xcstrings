        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URL"
          }
        }
      }
    },
    "Unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可用"
          }
        }
      }
    },
    "Unavailable Action": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可用的动作"
          }
        }
      }
    },
    "Unavailable: %@\n%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可用：%1$@\n%2$@"
          }
        }
      }
    },
    "Understand the separate layers of authority used by Spinnet and its Plugins.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解 Spinnet 及其插件所用的各层权限。"
          }
        }
      }
    },
    "Undo Appearance change": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销外观更改"
          }
        }
      }
