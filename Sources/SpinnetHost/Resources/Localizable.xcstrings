    "Undo Slot edit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销槽位编辑"
          }
        }
      }
    },
    "Up": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上箭头"
          }
        }
      }
    },
    "Update %@ to %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %1$@ 更新到 %2$@"
          }
        }
      }
    },
    "Update to %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新到 %@"
          }
        }
      }
    },
    "Use Plugin Setting (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用插件设置（%@）"
          }
        }
      }
    },
    "Use https and put {query} once, in the path or query, where the search text goes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 https，并在路径或查询中放置一次 {query}，作为搜索文本的位置。"
          }
        }
      }
    },
    "Use the Settings navigation to switch between General, Menu, Appearance, Privacy & Permissions, and About.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用设置导航在通用、菜单、外观、隐私与权限和关于之间切换。"
          }
        }
      }
    },
    "Use the arrow keys and Return for a Primary Action. Right-click or Option-Return to choose from the configured Actions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方向键和 Return 键执行主要动作。右键点按或按 Option-Return 从已配置的动作中选择。"
          }
        }
      }
    },
    "Use the default Menu's Menu Item in this Slot for this App": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 在此槽位中使用默认菜单的菜单项"
          }
        }
      }
    },
    "Use the exact title shown in the target app's Services menu. Select text in that app first; submenu entries use slash separators.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用目标 App“服务”菜单中显示的确切标题。请先在该 App 中选择文本；子菜单条目用斜杠分隔。"
          }
        }
      }
    },
    "Used for the selected Menu Slot and focus states.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于所选菜单槽位和聚焦状态。"
          }
        }
      }
    },
    "Uses the Plugin Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用插件设置。"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "Version %@ (Build %@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %1$@（构建 %2$@）"
          }
        }
      }
    },
    "Version %@ is available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@ 可用。"
          }
        }
      }
    },
    "View Release": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看版本"
          }
        }
      }
    },
    "Walk through System Permissions and how to open the Menu again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次了解系统权限以及如何打开菜单。"
          }
        }
      }
    },
    "Weight": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字重"
          }
        }
      }
    },
    "Welcome Guide": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎指南"
          }
        }
      }
    },
    "What %@ keeps for itself between runs. Removing the Plugin deletes it; an update keeps it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在多次运行之间为自己保存的内容。移除插件会删除它；更新会保留它。"
          }
        }
      }
    },
    "When enabled, hold the mouse trigger, drag to a Menu Item, and release to run it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，按住鼠标触发键，拖移到菜单项上，松开即可运行。"
          }
        }
      }
    },
    "When off, the Status Item still appears while a Task or Effect is ongoing. Open Spinnet again to show Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，任务或效果进行时仍会显示菜单栏图标。再次打开 Spinnet 可显示设置。"
          }
        }
      }
    },
    "Write Clipboard": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入剪贴板"
          }
        }
      }
    },
    "You can revoke access later in Plugin Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你之后可以在插件设置中撤销访问权限。"
          }
        }
      }
    },
    "macOS background activity status is unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取 macOS 后台活动状态"
          }
        }
      }
    },
    "not set": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
