        }
      }
    },
    "Open Spinnet's source repository in the default browser.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在默认浏览器中打开 Spinnet 的源代码仓库。"
          }
        }
      }
    },
    "Open Welcome Guide": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
