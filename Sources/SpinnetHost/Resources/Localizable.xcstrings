          }
        }
      }
    },
    "Open http and https links in a browser. The browser, not the Plugin, loads the page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中打开 http 和 https 链接。网页由浏览器载入，而不是插件。"
          }
        }
      }
    },
    "Open local files and folders in Finder or their default app, including launching applications. The receiving app can read the file; the Plugin receives no file contents.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达或默认 App 中打开本地文件和文件夹，包括启动应用程序。接收的 App 可以读取文件；插件不会收到任何文件内容。"
          }
        }
      }
    },
    "Open the configuration for this Menu Item.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开此菜单项的配置。"
