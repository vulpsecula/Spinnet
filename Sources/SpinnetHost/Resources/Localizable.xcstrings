{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@ is installed again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ 已重新安装。"
          }
        }
      }
    },
    "%@ %@ is installed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ 已安装。"
          }
        }
      }
    },
    "%@ (Optional): Granted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（可选）：已授予"
          }
        }
      }
    },
    "%@ (Optional): Not granted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（可选）：未授予"
          }
        }
      }
    },
    "%@ (Unavailable: %@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（不可用：%2$@）"
          }
        }
      }
    },
    "%@ Last checked %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@上次检查：%2$@。"
          }
        }
      }
    },
    "%@ Page Content": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@页面内容"
          }
        }
      }
    },
    "%@ Some changes could not be restored. Review the saved settings and credentials before retrying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 部分更改无法恢复。重试前请检查已存储的设置和凭据。"
          }
        }
      }
    },
    "%@ accent colour": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@强调色"
          }
        }
      }
    },
    "%@ and %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@和%2$@"
          }
        }
      }
    },
    "%@ application icon": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 应用程序图标"
          }
        }
      }
    },
    "%@ configuration input": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@配置输入"
          }
        }
      }
    },
    "%@ could not be checked: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查 %1$@：%2$@"
          }
        }
      }
    },
    "%@ forgets everything it kept for itself. Its settings, access, and Menu Items stay as they are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会忘记为自己保存的一切。它的设置、访问权限和菜单项保持不变。"
          }
        }
      }
    },
    "%@ granted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授予%@"
          }
        }
      }
    },
    "%@ is not one of its offered values.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是它提供的值之一。"
          }
        }
      }
    },
    "%@ is the latest version.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是最新版本。"
          }
        }
      }
    },
    "%@ is updated from %@ to %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已从 %2$@ 更新到 %3$@。"
          }
        }
      }
    },
    "%@ is updated to %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已更新到 %2$@。"
          }
        }
      }
    },
    "%@ may monitor %@. Remove that button's click, drag, and scroll assignments in the other utility.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 可能在监视%2$@。请在该工具中移除这个按键的点按、拖移和滚动分配。"
          }
        }
      }
    },
    "%@ must be an https address, such as https://api.example.com.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必须是 https 地址，例如 https://api.example.com。"
          }
        }
      }
    },
    "%@ percent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%%"
          }
        }
      }
    },
    "%@ removed. Its Slots use the default Menu.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %@。它的槽位使用默认菜单。"
          }
        }
      }
    },
    "%@ removed. Menu Items that used it are kept and marked unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %@。使用它的菜单项会保留并标记为不可用。"
          }
        }
      }
    },
    "%@ required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要%@"
          }
        }
      }
    },
    "%@ was refused: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 被拒：%2$@"
          }
        }
      }
    },
    "%@ · Optional": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 可选"
          }
        }
      }
    },
    "%@, Commands: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，命令：%2$@"
          }
        }
      }
    },
    "%@, from the default Menu": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，来自默认菜单"
          }
        }
      }
    },
    "%@, refused: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，被拒：%2$@"
          }
        }
      }
    },
    "%@, unavailable: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，不可用：%2$@"
          }
        }
      }
    },
    "%lld Capability decisions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项能力决定"
          }
        }
      }
    },
    "%lld Plugin updates available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个插件更新可用。"
          }
        }
      }
    },
    "%lld Plugins could not be checked. The Library shows why.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个插件无法检查。资源库中显示了原因。"
          }
        }
      }
    },
    "%lld disabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停用 %lld 个"
          }
        }
      }
    },
    "%lld loaded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已载入 %lld 个"
          }
        }
      }
    },
    "%lld ms": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 毫秒"
          }
        }
      }
    },
    "%lld of 12 Slots": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / 12 个槽位"
          }
        }
      }
    },
    "%lld refused": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被拒 %lld 个"
          }
        }
      }
    },
    ", ": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "、"
          }
        }
      }
    },
    "1 Plugin update available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 1 个插件更新可用。"
          }
        }
      }
    },
    "1 day": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 天"
          }
        }
      }
    },
    "1 month": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个月"
          }
        }
      }
    },
    "1 week": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 周"
          }
        }
      }
    },
    "A Menu must contain at least one Slot": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单必须至少包含一个槽位"
          }
        }
      }
    },
    "A Menu must contain at least one Slot.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单必须至少包含一个槽位。"
          }
        }
      }
    },
    "A credential must be one line of at most 4096 characters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭据必须是不超过 4096 个字符的一行。"
          }
        }
      }
    },
    "A credential must have a valid reference and one line of at most 4096 characters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭据必须有有效的引用，且为不超过 4096 个字符的一行。"
          }
        }
      }
    },
    "A mouse-first macOS action environment centered on a radial Menu.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以环形菜单为中心、鼠标优先的 macOS 动作环境。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Accent Colour": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强调色"
          }
        }
      }
    },
    "Access applies Plugin-wide. Commands requiring denied access remain unavailable; optional access is skipped when not granted. Menu Items are preserved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问权限作用于整个插件。需要被拒访问权限的命令保持不可用；未授予的可选访问权限会被跳过。菜单项会保留。"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "Accessibility enables mouse triggers and protected keyboard recording": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能用于鼠标触发键和受保护的键盘录制"
          }
        }
      }
    },
    "Accessibility granted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授予辅助功能"
          }
        }
      }
    },
    "Accessibility is recommended for mouse triggers, selected text, Paste, and Cut. You can skip and use permission-free Commands. Input Monitoring is not requested. Screen Recording and app-specific Automation are deferred until an explicit feature action.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议为鼠标触发键、所选文本、粘贴和剪切授予辅助功能权限。你也可以跳过并使用无需权限的命令。Spinnet 不请求输入监控。屏幕录制和针对特定 App 的自动化要等到你明确使用相关功能时才请求。"
          }
        }
      }
    },
    "Accessibility status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能状态"
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "致谢"
          }
        }
      }
    },
    "Action Parameters": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作参数"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add %@ to selected Slot": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 添加到所选槽位"
          }
        }
      }
    },
    "Add App": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 App"
          }
        }
      }
    },
    "Add Row": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加行"
          }
        }
      }
    },
    "Add a row to %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 %@ 添加一行"
          }
        }
      }
    },
    "Add empty Slot": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加空槽位"
          }
        }
      }
    },
    "Add to %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到 %@"
          }
        }
      }
    },
    "Add to selected empty Slot or drag it to a Slot": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到所选空槽位，或将其拖到槽位"
          }
        }
      }
    },
    "Adjust continuously, snap to three recommended sizes, or enter an exact percentage.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续调整、吸附到三个推荐大小，或输入精确的百分比。"
          }
        }
      }
    },
    "After Capture": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截屏后"
          }
        }
      }
    },
    "Allow %@ to contact %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 %1$@ 联络 %2$@"
          }
        }
      }
    },
    "Allow Spinnet in System Settings → General → Login Items.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“系统设置”→“通用”→“登录项”中允许 Spinnet。"
          }
        }
      }
    },
    "Allow Spinnet in macOS Login Items & Extensions, then return here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 macOS“登录项与扩展”中允许 Spinnet，然后返回此处。"
          }
        }
      }
    },
    "Allow Spinnet to control %@ in macOS Automation settings, then connect again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 macOS 自动化设置中允许 Spinnet 控制 %@，然后再次连接。"
          }
        }
      }
    },
    "Allows Spinnet to perform system changes for Tasks you confirm. macOS may also ask for administrator approval for a specific operation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Spinnet 为你确认的任务执行系统更改。macOS 也可能为特定操作要求管理员批准。"
          }
        }
      }
    },
    "Alternate Action %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备选动作 %@"
          }
        }
      }
    },
    "Alternate Action: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备选动作：%@"
          }
        }
      }
    },
    "Alternate Actions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备选动作"
          }
        }
      }
    },
    "App": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        }
      }
    },
    "App Connections": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 连接"
          }
        }
      }
    },
    "App Overrides use it in %@; they stay and are marked unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 覆盖在 %@ 中使用了它；它们会保留并标记为不可用。"
          }
        }
      }
    },
    "App-wide preferences for Spinnet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spinnet 的全局偏好设置。"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Appearance changes are shown here. Actions and Menu edits are disabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观更改会显示在这里。动作和菜单编辑已停用。"
          }
        }
      }
    },
    "Application": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用程序"
          }
        }
      }
    },
    "Application bundle identifier": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用程序 Bundle 标识符"
          }
        }
      }
    },
    "Approval required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要批准"
          }
        }
      }
    },
    "Approve Spinnet…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准 Spinnet…"
          }
        }
      }
    },
    "Apps without a bundle identifier cannot be added.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法添加没有 Bundle 标识符的 App。"
          }
        }
      }
    },
    "Ask Spinnet to close the front window of, quit or force quit the App in front, or one the Plugin identified. Close and Quit are the App's own ⌘W and ⌘Q, so it may ask you to save first, and only Apps whose menus offer them can be closed or quit that way. Spinnet names the App and asks you before a force quit, or before closing or quitting an App that is not in front; it never closes or quits Spinnet or parts of macOS.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求 Spinnet 关闭前台 App 或插件识别的 App 的最前面窗口、退出或强制退出该 App。关闭和退出就是 App 自身的 ⌘W 和 ⌘Q，因此它可能会先请你存储，并且只有菜单中提供这些命令的 App 才能这样关闭或退出。强制退出之前，或关闭、退出不在前台的 App 之前，Spinnet 会写明该 App 并征求你的同意；它永远不会关闭或退出 Spinnet 或 macOS 的组成部分。"
          }
        }
      }
    },
    "Ask the Host to take a screenshot of an area, the full screen, or a window, then copy it or save it to a folder you chose for the Menu Item. The Plugin never receives the image.": {
