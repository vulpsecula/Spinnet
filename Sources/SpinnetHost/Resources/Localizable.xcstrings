        }
      }
    },
    "Use the Settings navigation to switch between General, Menu, Appearance, Privacy & Permissions, and About.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用设置导航在通用、菜单、外观、隐私与权限和关于之间切换。"
          }
        }
      }
    },
    "Use the arrow keys and Return for a Primary Action. Right-click to choose from the configured Actions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方向键和 Return 键执行主要动作。右键点按从已配置的动作中选择。"
          }
        }
      }
