{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External App connections r1 manifest members",
  "type": "object",
  "required": [
    "candidate_contracts",
    "external_app_connections"
  ],
  "properties": {
    "candidate_contracts": {
      "type": "array",
      "contains": {
        "type": "object",
        "required": [
          "name",
          "revision"
        ],
        "properties": {
          "name": {
            "const": "external_app_connections"
          },
          "revision": {
            "const": 1
          }
        }
      }
    },
    "external_app_connections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "bundle_id",
          "command_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "bundle_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "command_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    }
  }
}
