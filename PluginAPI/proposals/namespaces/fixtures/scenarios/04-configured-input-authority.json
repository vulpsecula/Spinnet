{
  "title": "A Command's configured input needs no Capability where Level 1's Host Command needed none",
  "manifest": {
    "api_level": 1,
    "candidate_contracts": [
      {
        "name": "collections",
        "revision": 1
      },
      {
        "name": "host_operations",
        "revision": 1
      },
      {
        "name": "namespaces",
        "revision": 1
      }
    ]
  },
  "covers": [
    "configured-input authority (design 6.2, choice N7)"
  ],
  "steps": [
    {
      "given": "not_declared",
      "capability": "open_url"
    },
    {
      "when": "menu_action",
      "command": {
        "id": "mail",
        "title": "Write to Support",
        "execution": "host",
        "is_configurable": true,
        "host_command": "open.url",
        "configuration_field": {
          "kind": "url",
          "title": "Link"
        }
      },
      "configured_input": "mailto:support@example.com"
    },
    {
      "expect": "opened",
      "because": "the user configured the link; any scheme, as Level 1's url.open"
    },
    {
      "when": "page_action_clicked",
      "view_action": {
        "perform": "open.url",
        "input": "https://example.com"
      }
    },
    {
      "expect": "refused_inline",
      "category": "capability_denied",
      "names": "open.url",
      "because": "the Plugin chose the link"
    },
    {
      "when": "page_action_clicked",
      "view_action": {
        "perform": "open.url",
        "input": "mailto:support@example.com"
      }
    },
    {
      "expect": "refused_inline",
      "category": "host_service_failed",
      "because": "a link the Plugin chooses is http or https with a host"
    }
  ]
}
