{
  "title": "Brew-shaped list, detail and task progress in the same shape",
  "covers": ["second workflow", "per-item actions", "page memory", "non-typing answers"],
  "manifest": {
    "api_level": 1,
    "candidate_contracts": [
      {
        "name": "collections",
        "revision": 1
      },
      {
        "name": "host_operations",
        "revision": 1
      },
      {
        "name": "namespaces",
        "revision": 1
      }
    ]
  },
  "steps": [
    {
      "given": "page_shown",
      "answer": {
        "page": {
          "id": "packages",
          "title": "Homebrew",
          "focus": "query",
          "content": [
            {
              "kind": "row",
              "id": "bar",
              "content": [
                {
                  "kind": "text_field",
                  "id": "query",
                  "title": "Search",
                  "placeholder": "Package name",
                  "collection": "packages"
                },
                {
                  "kind": "choice_field",
                  "id": "scope",
                  "title": "Show",
                  "choices": [
                    "installed",
                    "outdated",
                    "all"
                  ],
                  "choice_titles": [
                    "Installed",
                    "Outdated",
                    "All Packages"
                  ],
                  "value": "all"
                }
              ]
            },
            {
              "kind": "list",
              "id": "packages",
              "rows": 10,
              "empty_text": "No packages match",
              "actions": [
                {
                  "id": "details",
                  "title": "Show Details",
                  "default": true
                },
                {"id": "upgrade", "title": "Upgrade"},
                {"id": "install", "title": "Install"},
                {
                  "id": "copy",
                  "title": "Copy Name",
                  "perform": "clipboard.write"
                }
              ],
              "items": [
                {"id": "formula:python@3.13", "title": "python@3.13", "subtitle": "Interpreted, interactive, object-oriented programming language", "accessory": "3.13.7 · Outdated", "text": "python@3.13", "actions": ["details", "upgrade", "copy"]},
                {"id": "formula:pyenv", "title": "pyenv", "subtitle": "Python version management", "accessory": "2.6.8", "text": "pyenv", "actions": ["details", "copy"]},
                {"id": "formula:pipx", "title": "pipx", "subtitle": "Execute binaries from Python packages in isolated environments", "accessory": "Not installed", "text": "pipx", "actions": ["details", "install", "copy"]}
              ],
              "has_more": true
            }
          ]
        },
        "state": {
          "scope": "all",
          "query": "py",
          "loaded": 3
        }
      }
    },
    {
      "expect": "item_actions",
      "item": "formula:pipx",
      "offered": [
        "Show Details",
        "Install",
        "Copy Name"
      ]
    },
    {
      "when": "context_menu",
      "item": "formula:python@3.13",
      "choose": "Upgrade"
    },
    {
      "expect": "event",
      "event": {
        "type": "item_action",
        "page": "packages",
        "collection": "packages",
        "action": "upgrade",
        "item": {
          "id": "formula:python@3.13",
          "text": "python@3.13"
        },
        "values": {
          "query": "py",
          "scope": "all"
        }
      }
    },
    {
      "when": "answer_arrives",
      "answer_illustrative": {
        "operation": {
          "perform": "tools.startTask",
          "input": {"profile": "homebrew", "operation": "upgrade", "arguments": {"package": "python@3.13"}},
          "notify": true
        },
        "note": "#70's illustrative start_task under the ID the namespace catalogue reserves, tools.startTask; the real operation is #88's"
      }
    },
    {
      "when": "type",
      "component": "query",
      "text": "pyt",
      "note": "the user keeps typing while the task runs"
    },
    {
      "when": "event_dispatched",
      "event_illustrative": {
        "type": "operation_finished",
        "perform": "tools.startTask",
        "outcome": "succeeded"
      }
    },
    {
      "when": "answer_arrives",
      "answer": {
        "page": {
          "id": "packages",
          "title": "Homebrew",
          "focus": "query",
          "content": [
            {
              "kind": "row",
              "id": "bar",
              "content": [
                {
                  "kind": "text_field",
                  "id": "query",
                  "title": "Search",
                  "placeholder": "Package name",
                  "collection": "packages"
                },
                {
                  "kind": "choice_field",
                  "id": "scope",
                  "title": "Show",
                  "choices": [
                    "installed",
                    "outdated",
                    "all"
                  ],
                  "choice_titles": [
                    "Installed",
                    "Outdated",
                    "All Packages"
                  ],
                  "value": "all"
                }
              ]
            },
            {
              "kind": "list",
              "id": "packages",
              "rows": 10,
              "empty_text": "No packages match",
              "actions": [
                {
                  "id": "details",
                  "title": "Show Details",
                  "default": true
                },
                {"id": "upgrade", "title": "Upgrade"},
                {"id": "install", "title": "Install"},
                {
                  "id": "copy",
                  "title": "Copy Name",
                  "perform": "clipboard.write"
                }
              ],
              "items": [
                {"id": "formula:python@3.13", "title": "python@3.13", "subtitle": "Interpreted, interactive, object-oriented programming language", "accessory": "3.13.8", "text": "python@3.13", "actions": ["details", "copy"]},
                {"id": "formula:pyenv", "title": "pyenv", "subtitle": "Python version management", "accessory": "2.6.8", "text": "pyenv", "actions": ["details", "copy"]},
                {"id": "formula:pipx", "title": "pipx", "subtitle": "Execute binaries from Python packages in isolated environments", "accessory": "Not installed", "text": "pipx", "actions": ["details", "install", "copy"]}
              ],
              "has_more": true
            }
          ]
        },
        "state": {
          "scope": "all",
          "query": "py",
          "loaded": 3
        }
      }
    },
    {
      "expect": "immediate_state",
      "component": "query",
      "text": "pyt",
      "caret": 3,
      "because": "an answer to a non-typing event never touches a kept field"
    },
    {
      "expect": "item_actions",
      "item": "formula:python@3.13",
      "offered": [
        "Show Details",
        "Copy Name"
      ]
    },
    {
      "when": "answer_arrives",
      "answer_illustrative": {
        "page": {
          "id": "package:python@3.13",
          "title": "python@3.13",
          "content": [
            {
              "kind": "progress",
              "id": "task",
              "title": "Upgrading",
              "stage": "Pouring python@3.13"
            },
            {
              "kind": "actions",
              "id": "buttons",
              "actions": [
                {"id": "cancel", "title": "Stop"}
              ]
            }
          ]
        },
        "note": "#81's Progress component would join the same tree, keeping its state by ID"
      }
    }
  ]
}
