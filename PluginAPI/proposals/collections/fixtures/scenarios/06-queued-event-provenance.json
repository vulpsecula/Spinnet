    "api_level": 1,
    "candidate_contracts": [
      {
        "name": "collections",
        "revision": 1
      },
      {
        "name": "host_operations",
        "revision": 1
      },
      {
        "name": "namespaces",
        "revision": 1
      }
    ]
  },
  "variants": [
    {
      "name": "an event from a page that was replaced is dropped",
      "steps": [
        {
          "given": "page_shown",
          "answer": {
            "page": {
              "id": "packages",
              "title": "Homebrew",
              "focus": "query",
              "content": [
                {
                  "kind": "row",
                  "id": "bar",
                  "content": [
                    {
                      "kind": "text_field",
                      "id": "query",
                      "title": "Search",
                      "placeholder": "Package name",
                      "collection": "packages"
                    },
                    {
                      "kind": "choice_field",
                      "id": "scope",
                      "title": "Show",
                      "choices": [
                        "installed",
                        "outdated",
                        "all"
                      ],
                      "choice_titles": [
                        "Installed",
                        "Outdated",
                        "All Packages"
                      ],
                      "value": "all"
                    }
                  ]
                },
                {
                  "kind": "list",
                  "id": "packages",
                  "rows": 10,
                  "empty_text": "No packages match",
                  "actions": [
                    {
                      "id": "details",
                      "title": "Show Details",
                      "default": true
                    },
                    {"id": "upgrade", "title": "Upgrade"},
                    {"id": "install", "title": "Install"},
                    {
                      "id": "copy",
                      "title": "Copy Name",
                      "perform": "clipboard.write"
                    }
                  ],
                  "items": [
                    {"id": "formula:python@3.13", "title": "python@3.13", "subtitle": "Interpreted, interactive, object-oriented programming language", "accessory": "3.13.7 · Outdated", "text": "python@3.13", "actions": ["details", "upgrade", "copy"]},
                    {"id": "formula:pyenv", "title": "pyenv", "subtitle": "Python version management", "accessory": "2.6.8", "text": "pyenv", "actions": ["details", "copy"]},
                    {"id": "formula:pipx", "title": "pipx", "subtitle": "Execute binaries from Python packages in isolated environments", "accessory": "Not installed", "text": "pipx", "actions": ["details", "install", "copy"]}
                  ],
                  "has_more": true
                }
              ]
            },
            "state": {
              "scope": "all",
              "query": "py",
              "loaded": 3
            }
          }
        },
        {
          "given": "event_running",
          "event": {
            "type": "item_action",
            "page": "packages",
            "collection": "packages",
            "action": "details",
            "item": {
              "id": "formula:pyenv",
              "text": "pyenv"
            },
            "values": {
              "query": "py",
              "scope": "all"
            }
          }
        },
        {
          "when": "typing_pause",
          "component": "query",
          "text": "pyt"
        },
        {
          "expect": "queued",
          "event": {
            "type": "field_changed",
            "page": "packages",
            "field": "query",
            "values": {
              "query": "pyt",
              "scope": "all"
            }
          }
        },
        {
          "when": "answer_arrives",
          "answer": {
            "page": {
              "id": "package:python@3.13",
              "title": "python@3.13",
              "subtitle": "Homebrew",
              "content": [
                {
                  "kind": "text",
                  "id": "summary",
                  "text": "**Interpreted, interactive, object-oriented programming language**\n\nInstalled 3.13.7, latest 3.13.8. [Homepage](https://www.python.org/)"
                },
                {
                  "kind": "text",
                  "id": "status",
                  "title": "Status",
                  "text": "Outdated"
                },
                {
                  "kind": "actions",
                  "id": "buttons",
                  "actions": [
                    {"id": "back", "title": "Back to Packages"},
                    {"id": "upgrade", "title": "Upgrade"},
                    {
                      "title": "Copy Name",
                      "perform": "clipboard.write",
                      "input": "python@3.13"
                    }
                  ]
                }
              ]
            },
            "state": {
              "scope": "all",
              "query": "py",
              "package": "formula:python@3.13"
            }
          }
        },
        {
          "expect": "dropped",
          "event_type": "field_changed",
          "because": "page packages is no longer on screen",
          "feedback": "none"
        }
      ]
    },
