        {
          "expect": "gesture",
          "displayed_target": "Notes"
        },
        {
          "expect": "event",
          "event": {
            "type": "item_action",
            "page": "search",
            "collection": "results",
            "action": "insert",
            "item": {
              "id": "1F408",
              "text": "🐈"
            },
            "values": {
              "query": "cat",
              "category": "all"
            }
          }
        },
        {
          "when": "answer_arrives",
          "answer": {
            "operation": {
              "kind": "insert_text",
              "id": "insert",
              "text": "🐈",
              "closes_view": true
            }
          }
        },
        {
          "expect": "executed",
          "into": "Notes",
          "text": "🐈",
          "view": "closes on success"
