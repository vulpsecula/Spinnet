                  "kind": "grid",
                  "id": "results",
                  "columns": 8,
                  "rows": 6,
                  "empty_text": "No emoji match",
                  "actions": [
                    {
                      "id": "insert",
                      "title": "Insert",
                      "default": true
                    },
                    {
                      "id": "copy",
                      "title": "Copy",
                      "perform": "copy_text"
