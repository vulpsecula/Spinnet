{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "PROPOSAL ONLY (#74). Not part of Plugin API Level 1, any stable Level, or any published Candidate Contract revision.",
  "title": "Spinnet Plugin pages and collections (draft candidate collections r1)",
  "description": "What a script declaring the draft Candidate Contract collections r1 (which requires host_operations r1) may answer and receive: an answer with a page, the page's components and collection, and the page events. Level 1 answers and events stay valid and keep their meaning; Level 1's own schemas are unchanged and refuse everything here.",
  "$defs": {
    "text": {
      "description": "A string with at least one character that is not white space.",
      "type": "string",
      "pattern": "\\S"
    },
    "identifier": {
      "description": "A page, component, section, item or action ID: not blank, at most 64 characters.",
      "type": "string",
      "pattern": "\\S",
      "maxLength": 64
    },
    "answer": {
      "description": "A candidate script's answer: Level 1's answer with view or, instead, page, plus host_operations' operation. An answer has at most one of view and page. An answer with neither keeps the view, page and state as they are, so {operation} alone requests an insertion without re-describing the page.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "view": {
          "description": "A Level 1 view, checked against plugin-view.schema.json (with host_operations' view_additions). It keeps Level 1's view rules.",
          "type": "object"
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "state": {
          "description": "Any JSON, at most 64 KiB; null when absent."
        },
        "close": {
          "const": true
        },
        "toast": {
          "$ref": "#/$defs/text"
        },
        "operation": {
          "$ref": "../bounded-host-operations/host-operations.schema.json#/$defs/operation"
        }
      },
      "allOf": [
        {
          "description": "An answer that closes the view describes nothing and requests nothing.",
          "if": {
            "required": [
              "close"
            ]
          },
          "then": {
            "properties": {
              "view": false,
              "page": false,
              "state": false,
              "operation": false
            }
          }
        },
        {
          "description": "An answer describes a view or a page, not both.",
          "if": {
            "required": [
              "page"
            ]
          },
          "then": {
            "properties": {
              "view": false
            }
          }
        },
        {
          "description": "Only an answer with a view or a page keeps a state.",
          "if": {
            "properties": {
              "view": false,
              "page": false
            }
          },
          "then": {
            "properties": {
              "state": false
            }
          }
        }
      ]
    },
    "page": {
      "description": "A View Page: an ID and a tree of identified components. Besides this shape the Host checks that component IDs are unique in the page (row children included), that there is at most one collection, that a text_field's collection names it, that focus and reset name components of the page, that item IDs are unique in the collection and its items number at most 2,000, that at most one item action is the default, that an item's actions name the collection's, and that the description is at most 256 KiB. A page that breaks any of these ends the View Session as a protocol violation.",
      "type": "object",
      "required": [
        "id",
        "title",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "description": "The View Page. The same ID refreshes the page on screen and keeps its immediate state; another ID changes page, remembering the last 4 pages' immediate state by ID."
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "subtitle": {
          "type": "string"
        },
        "shows_insertion_target": {
          "description": "host_operations: the Host draws a line naming the App insertion would go to now. Captured with each gesture.",
          "type": "boolean"
        },
        "focus": {
          "$ref": "#/$defs/identifier",
          "description": "The component focused when the page is new or reset; else the first text_field, else the collection."
        },
        "reset": {
          "description": "One-shot: \"page\" starts every component and the page's memory again from this description; a list starts those components again. A reset of a text_field with an open input-method composition is dropped for that field.",
          "oneOf": [
            {
              "const": "page"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          ]
        },
        "content": {
          "description": "Laid out top to bottom. At most 40 components counting row children, and at most one list or grid.",
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    },
    "component": {
      "description": "A View Component of a page, by kind.",
      "oneOf": [
        {
          "$ref": "#/$defs/row"
        },
        {
          "$ref": "#/$defs/text_field"
        },
        {
          "$ref": "#/$defs/choice_field"
        },
        {
          "$ref": "#/$defs/text_block"
        },
        {
          "$ref": "#/$defs/actions"
        },
        {
          "$ref": "#/$defs/list"
        },
        {
          "$ref": "#/$defs/grid"
        }
      ]
    },
    "leaf": {
      "description": "What a row may hold.",
      "oneOf": [
        {
          "$ref": "#/$defs/text_field"
        },
        {
          "$ref": "#/$defs/choice_field"
        },
        {
          "$ref": "#/$defs/text_block"
        },
        {
          "$ref": "#/$defs/actions"
        }
      ]
    },
    "row": {
      "description": "Up to 4 leaf components side by side; a text_field takes the spare width. Rows do not nest and hold no collection.",
      "type": "object",
      "required": [
        "kind",
        "id",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "row"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/leaf"
          }
        }
      }
    },
    "text_field": {
      "description": "A one-line text field, Level 1's text field with an ID. Its text, caret, selection and composition belong to the Host until the Plugin resets it.",
      "type": "object",
      "required": [
        "kind",
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text_field"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "placeholder": {
          "type": "string"
        },
        "value": {
          "description": "The initial text, applied only when the field is new or reset.",
          "type": "string"
        },
        "status": {
          "$ref": "../../schemas/plugin-view.schema.json#/$defs/text"
        },
        "accent": {
          "enum": [
            "blue",
            "indigo",
            "purple",
            "pink",
            "red",
            "orange",
            "green",
            "teal",
            "gray"
          ]
        },
        "collection": {
          "$ref": "#/$defs/identifier",
          "description": "The page's collection this field searches: Up and Down move its selection and Return performs its default item action. Without it, Return sends submitted."
        }
      }
    },
    "choice_field": {
      "description": "A pop-up of choices. A change is delivered at once as field_changed.",
      "type": "object",
      "required": [
        "kind",
        "id",
        "title",
        "choices"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "choice_field"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "choice_titles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "value": {
          "description": "The initial choice, applied only when the field is new or reset.",
          "type": "string"
        }
      }
    },
    "text_block": {
      "description": "Text in Level 1's Markdown subset (views.md), with an optional title.",
      "type": "object",
      "required": [
        "kind",
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "actions": {
      "description": "A row of buttons. No button has a shortcut.",
      "type": "object",
      "required": [
        "kind",
        "id",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "actions"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/page_action"
          }
        }
      }
    },
    "page_action": {
      "description": "A button: an event action with id and title, delivering action_chosen with the page's values and selection, or a Level 1 standard action. No shortcut.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "perform": {
          "enum": [
            "copy_text",
            "open_url",
            "insert_text",
            "open_plugin_settings"
          ]
        },
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "closes_view": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "perform": false
            }
          },
          "then": {
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "text": false,
              "url": false,
              "closes_view": false
            }
          }
        },
        {
          "if": {
            "required": [
              "perform"
            ],
            "properties": {
              "perform": {
                "enum": [
                  "copy_text",
                  "insert_text"
                ]
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "url": false
            }
          }
        },
        {
          "if": {
            "required": [
              "perform"
            ],
            "properties": {
              "perform": {
                "const": "open_url"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ],
            "properties": {
              "text": false
            }
          }
        },
        {
          "if": {
            "required": [
              "perform"
            ],
            "properties": {
              "perform": {
                "const": "open_plugin_settings"
              }
            }
          },
          "then": {
            "properties": {
              "text": false,
              "url": false,
              "closes_view": false
            }
          }
        }
      ]
    },
    "list": {
      "description": "A collection drawn as rows: symbol, title, subtitle and accessory.",
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "list"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "items": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "has_more": {
          "description": "The Plugin has items after the last one described. Near the end the Host sends load_more, at most one outstanding and once per loaded count.",
          "type": "boolean"
        },
        "selected": {
          "$ref": "#/$defs/identifier",
          "description": "The item selected when the collection is new or reset; else the first item. Ignored while the collection is kept."
        },
        "empty_text": {
          "$ref": "#/$defs/text"
        },
        "actions": {
          "description": "Item actions offered on every item, unless an item lists its own subset. At most one is the default, which Return and double-click perform.",
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/item_action"
          }
        },
        "rows": {
          "description": "Rows visible initially, 1 to 12; 8 by default.",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "items"
              ],
              "properties": {
                "sections": false
              }
            },
            {
              "required": [
                "sections"
              ],
              "properties": {
                "items": false
              }
            }
          ]
        }
      ]
    },
    "grid": {
      "description": "A collection drawn as square cells showing each item's symbol, or its title when it has none.",
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "grid"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "items": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "has_more": {
          "description": "The Plugin has items after the last one described. Near the end the Host sends load_more, at most one outstanding and once per loaded count.",
          "type": "boolean"
        },
        "selected": {
          "$ref": "#/$defs/identifier",
          "description": "The item selected when the collection is new or reset; else the first item. Ignored while the collection is kept."
        },
        "empty_text": {
          "$ref": "#/$defs/text"
        },
        "actions": {
          "description": "Item actions offered on every item, unless an item lists its own subset. At most one is the default, which Return and double-click perform.",
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/item_action"
          }
        },
        "columns": {
          "description": "Cells across, 2 to 12; 8 by default. Cells are square and divide the width.",
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "rows": {
          "description": "Rows visible initially, 1 to 12; 6 by default.",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "items"
              ],
              "properties": {
                "sections": false
              }
            },
            {
              "required": [
                "sections"
              ],
              "properties": {
                "items": false
              }
            }
          ]
        }
      ]
    },
    "section": {
      "description": "A titled group of items. Its header stays visible while its items scroll.",
      "type": "object",
      "required": [
        "id",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "description": "One item of a collection. Images and icons are not part of this revision.",
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "description": "Unique in the collection, sections included."
        },
        "title": {
          "$ref": "#/$defs/text",
          "maxLength": 256,
          "description": "The row text, the cell's tooltip, and the VoiceOver label."
        },
        "subtitle": {
          "type": "string",
          "maxLength": 256
        },
        "symbol": {
          "description": "A short glyph: the grid cell's content, a list row's leading glyph.",
          "type": "string",
          "pattern": "\\S",
          "maxLength": 32
        },
        "accessory": {
          "description": "Trailing list text, such as a version.",
          "type": "string",
          "maxLength": 64
        },
        "text": {
          "description": "What copy_text and insert_text item actions use, and what item_action's snapshot carries; without it, symbol, else title.",
          "type": "string",
          "maxLength": 4096
        },
        "actions": {
          "description": "The collection's item actions this item offers, by ID; all of them when absent.",
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "item_action": {
      "description": "An action offered on items. No shortcut: Return, double-click, the context menu, the selection bar and the Host's own keys are its only triggers.",
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "default": {
          "description": "Return and double-click perform this action. At most one per collection.",
          "const": true
        },
        "perform": {
          "description": "A standard action the Host performs on the item's text, without a View Event. Without perform the action delivers item_action.",
          "enum": [
            "copy_text",
            "insert_text"
          ]
        },
        "closes_view": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "perform": false
            }
          },
          "then": {
            "properties": {
              "closes_view": false
            }
          }
        }
      ]
    },
    "values": {
      "$ref": "../../schemas/view-session.schema.json#/$defs/values"
    },
    "selection": {
      "description": "The page's collection mapped to its selected item ID, or null when nothing is selected. Empty for a page without a collection.",
      "type": "object",
      "maxProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "item_snapshot": {
      "description": "The item as shown when the user acted: its ID, its section, and its resolved text when that differs from its ID.",
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "section": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "event": {
      "description": "One View Event under the candidate: a Level 1 event (from a Level 1 view, and setting or section events) or a page event.",
      "oneOf": [
        {
          "$ref": "../../schemas/view-session.schema.json#/$defs/event"
        },
        {
          "$ref": "#/$defs/page_event"
        }
      ]
    },
    "page_event": {
      "description": "An event from a page, or an explicit call. Every page event names its page; the Host drops it unless that page, and the component it came from, are still on screen, unchanged in kind and not reset since.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "field_changed",
            "submitted",
            "action_chosen",
            "item_action",
            "load_more",
            "called"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "field_changed"
              }
            }
          },
          "then": {
            "required": [
              "page",
              "field",
              "values"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "page",
                "field",
                "values"
              ]
            },
            "properties": {
              "page": {
                "$ref": "#/$defs/identifier"
              },
              "field": {
                "$ref": "#/$defs/identifier"
              },
              "values": {
                "$ref": "#/$defs/values"
              }
            }
          }
        },
        {
          "description": "Return in a text_field without a collection.",
          "if": {
            "properties": {
              "type": {
                "const": "submitted"
              }
            }
          },
          "then": {
            "required": [
              "page",
              "field",
              "values",
              "selection"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "page",
                "field",
                "values",
                "selection"
              ]
            },
            "properties": {
              "page": {
                "$ref": "#/$defs/identifier"
              },
              "field": {
                "$ref": "#/$defs/identifier"
              },
              "values": {
                "$ref": "#/$defs/values"
              },
              "selection": {
                "$ref": "#/$defs/selection"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "action_chosen"
              }
            }
          },
          "then": {
            "required": [
              "page",
              "action",
              "values",
              "selection"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "page",
                "action",
                "values",
                "selection"
              ]
            },
            "properties": {
              "page": {
                "$ref": "#/$defs/identifier"
              },
              "action": {
                "$ref": "#/$defs/identifier"
              },
              "values": {
                "$ref": "#/$defs/values"
              },
              "selection": {
                "$ref": "#/$defs/selection"
              }
            }
          }
        },
        {
          "description": "An item action without perform, from Return, double-click, the context menu or the selection bar. A gesture: its answer may request an operation.",
          "if": {
            "properties": {
              "type": {
                "const": "item_action"
              }
            }
          },
          "then": {
            "required": [
              "page",
              "collection",
              "action",
              "item",
              "values"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "page",
                "collection",
                "action",
                "item",
                "values"
              ]
            },
            "properties": {
              "page": {
                "$ref": "#/$defs/identifier"
              },
              "collection": {
                "$ref": "#/$defs/identifier"
              },
              "action": {
                "$ref": "#/$defs/identifier"
              },
              "item": {
                "$ref": "#/$defs/item_snapshot"
              },
              "values": {
                "$ref": "#/$defs/values"
              }
            }
          }
        },
        {
          "description": "The user neared the end of a collection with has_more. Not a gesture.",
          "if": {
            "properties": {
              "type": {
                "const": "load_more"
              }
            }
          },
          "then": {
            "required": [
              "page",
              "collection",
              "loaded"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "page",
                "collection",
                "loaded"
              ]
            },
            "properties": {
              "page": {
                "$ref": "#/$defs/identifier"
              },
              "collection": {
                "$ref": "#/$defs/identifier"
              },
              "loaded": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2000
              }
            }
          }
        },
        {
          "description": "An explicit call of one of the Plugin's Actions while its View Session is open (#78). The input global holds that Action's effective input and state the session's last good state. Not bound to a page. A gesture.",
          "if": {
            "properties": {
              "type": {
                "const": "called"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type"
              ]
            }
          }
        }
      ]
    }
  }
}
