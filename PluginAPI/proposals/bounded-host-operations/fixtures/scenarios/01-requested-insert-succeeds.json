{
  "title": "A requested insertion goes to the App the Host showed",
  "manifest": {
    "api_level": 1,
    "candidate_contracts": [
      {
        "name": "host_operations",
        "revision": 1
      }
    ]
  },
  "covers": [
    "commit",
    "deferred insertion",
    "closes_view",
    "Host-only disclosure"
  ],
  "steps": [
    {
      "given": "frontmost",
      "app": "App A"
    },
    {
      "given": "view_open",
      "answer": {
        "view": {
          "title": "Emoji",
          "shows_insertion_target": true,
          "form": {
            "fields": [
              {
                "kind": "text",
                "key": "query",
                "title": "Search",
                "value": "smile"
              }
            ],
            "submit_on_return": true
          },
          "detail": {
            "sections": [
              {
                "id": "results",
                "text": "😀 grinning face\n😄 grinning face with smiling eyes"
              }
            ]
          },
          "actions": [
            {
              "title": "Copy 😀",
              "perform": "copy_text",
              "text": "😀"
            }
          ]
        },
        "state": {
          "recent": []
        }
      }
    },
    {
      "expect": "hint",
      "app": "App A"
    },
    {
      "when": "gesture",
      "event": {
        "type": "submitted",
        "values": {
          "query": "smile"
        }
      }
    },
    {
      "script_answers": {
        "view": {
          "title": "Emoji",
          "shows_insertion_target": true,
          "form": {
            "fields": [
              {
                "kind": "text",
                "key": "query",
                "title": "Search",
                "value": "smile"
              }
            ],
            "submit_on_return": true
          },
          "detail": {
            "sections": [
              {
                "id": "results",
                "text": "😀 grinning face\n😄 grinning face with smiling eyes"
              }
            ]
          },
          "actions": [
            {
              "title": "Copy 😀",
              "perform": "copy_text",
              "text": "😀"
            }
          ]
        },
        "state": {
          "recent": [
            "😀"
          ]
        },
        "operation": {
          "kind": "insert_text",
          "id": "insert",
          "text": "😀",
          "closes_view": true
        }
      }
    },
    {
      "expect": "committed",
      "state": {
        "recent": [
          "😀"
        ]
      }
    },
    {
      "expect": "executed",
      "kind": "insert_text",
      "into": "App A"
    },
    {
      "expect": "outcome",
      "outcome": "succeeded"
    },
    {
      "expect": "view_closed"
    },
    {
      "expect": "not_delivered",
      "because": "notify not set"
    }
  ]
}
