{
  "title": "Synchronous insert_text inside a View Session",
  "covers": [
    "synchronous insertion",
    "Level 1 retained",
    "target_not_shown"
  ],
  "variants": [
    {
      "manifest": {
        "api_level": 1,
        "candidate_contracts": [
          {
            "name": "host_operations",
            "revision": 1
          }
        ]
      },
      "name": "from a gesture, target unchanged",
      "steps": [
        {
          "given": "frontmost",
          "app": "App A"
        },
        {
          "given": "view_open",
          "answer": {
            "view": {
              "title": "Emoji",
              "shows_insertion_target": true,
              "form": {
                "fields": [
                  {
                    "kind": "text",
                    "key": "query",
                    "title": "Search",
                    "value": "smile"
                  }
                ],
                "submit_on_return": true
              },
              "detail": {
                "sections": [
                  {
                    "id": "results",
                    "text": "😀 grinning face\n😄 grinning face with smiling eyes"
                  }
                ]
              },
              "actions": [
                {
                  "title": "Copy 😀",
                  "perform": "copy_text",
                  "text": "😀"
                }
              ]
            }
          }
        },
        {
          "when": "gesture",
          "event": {
            "type": "submitted",
            "values": {
              "query": "smile"
            }
          },
          "displayed_target": "App A"
        },
        {
          "script_calls": "insert_text",
          "input": "😀"
        },
        {
          "expect": "executed",
          "into": "App A",
          "via": "App A's focused element, not the system-wide one"
        }
      ]
    },
