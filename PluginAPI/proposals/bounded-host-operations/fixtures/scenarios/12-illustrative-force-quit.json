{
  "title": "Illustrative mutating kind: Force Quit with Host confirmation (shape owned by #83)",
  "manifest": {
    "api_level": 1,
    "candidate_contracts": [
      {
        "name": "host_operations",
        "revision": 2
      },
      {
        "name": "namespaces",
        "revision": 1
      }
    ]
  },
  "manifest_note": "A hypothetical later revision whose members would add apps.quit, which the namespace catalogue reserves for #83; not proposed by this revision",
  "covers": [
    "confirmation",
    "decline",
    "expiry",
    "target re-validation"
  ],
  "illustrative": true,
  "variants": [
    {
      "name": "confirmed",
      "steps": [
        {
          "given": "frontmost",
          "app": "App A"
        },
        {
          "when": "gesture",
          "event": {
            "type": "action_chosen",
            "action": "force-quit"
          }
        },
        {
          "script_answers_illustrative": {
            "operation": {
              "perform": "apps.quit",
              "input": {
                "target": "frontmost",
                "force": true
              },
              "notify": true
            }
          }
        },
        {
          "expect": "confirmation",
          "text_from": "Host",
          "names": "App A"
        },
        {
          "when": "user_confirms"
        },
        {
          "expect": "target_revalidated",
          "by": "pid + bundle ID + launch date"
        },
        {
          "expect": "outcome",
          "outcome": "succeeded"
        }
      ]
    },
    {
      "name": "declined",
      "steps": [
        {
          "given": "confirming",
          "perform": "apps.quit"
        },
        {
          "when": "user_declines"
        },
        {
          "expect": "outcome",
          "outcome": "declined"
        },
        {
          "expect": "not_executed"
        }
      ]
    },
    {
      "name": "expired",
      "steps": [
        {
          "given": "confirming",
          "perform": "apps.quit"
        },
        {
          "when": "time_passes",
          "seconds": 60
        },
        {
          "expect": "outcome",
          "outcome": "expired"
        }
      ]
    },
    {
      "name": "App gone before execution",
      "steps": [
        {
          "given": "confirming",
          "perform": "apps.quit"
        },
        {
          "when": "target_exits"
        },
        {
          "when": "user_confirms"
        },
        {
          "expect": "outcome",
          "outcome": "refused",
          "reason": "no_target"
        }
      ]
    }
  ]
}
