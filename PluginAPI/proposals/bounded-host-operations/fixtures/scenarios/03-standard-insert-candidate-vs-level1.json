{
  "title": "Standard insert action: frontmost at execution under the candidate, origin under Level 1",
  "covers": [
    "standard insertion",
    "Level 1 retained"
  ],
  "variants": [
    {
      "manifest": {
        "api_level": 1
      },
      "steps": [
        {
          "given": "frontmost",
          "app": "App A"
        },
        {
          "given": "view_open",
          "answer": {
            "view": {
              "title": "T",
              "actions": [
                {
                  "title": "Insert",
                  "perform": "insert_text",
                  "text": "x"
                }
              ]
            }
          },
          "origin": "App A"
        },
        {
          "when": "frontmost_becomes",
          "app": "App B"
        },
        {
          "when": "standard_action",
          "perform": "insert_text"
        },
        {
          "expect": "executed",
