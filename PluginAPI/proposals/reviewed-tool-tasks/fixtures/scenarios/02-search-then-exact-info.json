{
  "title": "Finding an uninstalled package: search names, then exact info for the shown window",
  "covers": [
    "uninstalled-package search",
    "exact info",
    "formula/cask",
    "input validation",
    "bounded output"
  ],
  "manifest": {
    "api_level": 2,
    "capabilities": [
      "read_reviewed_tools"
    ],
    "reviewed_tools": [
      {
        "tool": "homebrew",
        "operations": [
          "installed",
          "outdated",
          "search",
          "info"
        ],
        "kinds": [
          "formula",
          "cask"
        ]
      }
    ]
  },
  "steps": [
    {
      "when": "the user types lib",
      "values": [
        {
          "definition": "tools.read.input",
          "value": {
            "tool": "homebrew",
            "operation": "search",
            "query": "lib"
          }
        }
      ],
      "then": "the Host runs brew search --formula -- lib and brew search --cask -- lib (non-TTY output has no headings, so kinds are only known per run) and returns 737 names, kind and name only"
    },
    {
      "when": "the Collection shows its first 50 rows",
      "values": [
        {
          "definition": "tools.read.input",
          "value": {
            "tool": "homebrew",
            "operation": "info",
            "kind": "formula",
            "names": [
              "aalib",
              "afflib",
              "alsa-lib"
            ]
          }
        }
      ],
      "then": "one brew info --json=v2 --formula -- aalib afflib alsa-lib process answers; 50 names took 0.58 s and projected to 6,829 bytes"
    },
    {
      "when": "the user types /^lib/ or --desc",
      "values": [
        {
          "definition": "tools.read.input",
          "value": {
            "tool": "homebrew",
            "operation": "search",
            "query": "lib"
          }
        }
      ],
      "then": "the SDK and Host refuse the query before anything runs (fixtures calls/search-regex, calls/search-option)"
    },
    {
      "when": "info names a package Homebrew does not know",
      "values": [
        {
          "definition": "tools.read.result",
          "value": {
            "tool": "homebrew",
            "operation": "info",
            "packages": [],
            "not_found": [
              "zzqxnotapackage"
            ]
          }
        }
      ],
      "then": "it is returned in not_found rather than failing the call"
    }
  ]
}
