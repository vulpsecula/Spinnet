          "pointer": "/json/today/summary"
        }
      },
      {
        "kind": "actions",
        "id": "buttons",
        "actions": [
          {
            "id": "refresh",
            "title": "Refresh"
          },
          {
            "id": "paris",
            "title": "Paris"
          }
        ]
      }
    ]
  },
  "state": null
}
