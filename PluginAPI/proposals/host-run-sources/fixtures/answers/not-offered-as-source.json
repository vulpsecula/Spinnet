{
  "page": {
    "id": "forecast",
    "title": "Forecast",
    "sources": [
      {
        "id": "forecast",
        "perform": "clipboard.read",
        "input": null,
        "error_pointer": "/error/message",
        "status_messages": {
          "429": "The forecast service is busy"
        }
      }
    ],
    "content": [
      {
        "kind": "text",
        "id": "summary",
