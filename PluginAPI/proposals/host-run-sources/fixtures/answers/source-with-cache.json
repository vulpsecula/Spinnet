{
  "page": {
    "id": "forecast",
    "title": "Forecast",
    "sources": [
      {
        "id": "forecast",
        "perform": "http.request",
        "input": {
          "method": "GET",
          "url": "https://api.example.com/v1/forecast?city=Berlin",
          "credential_uses": [
            {
              "reference": "example_key",
              "header": "Authorization",
              "template": "Bearer {credential}"
            }
          ]
        },
        "error_pointer": "/error/message",
        "status_messages": {
          "429": "The forecast service is busy"
        },
        "cache": true
      }
    ],
    "content": [
      {
        "kind": "text",
        "id": "summary",
        "title": "Today",
        "text": "Loading…",
        "bind": {
          "source": "forecast",
          "pointer": "/json/today/summary"
        }
      },
      {
        "kind": "actions",
        "id": "buttons",
        "actions": [
          {
            "id": "refresh",
            "title": "Refresh"
          },
          {
            "id": "paris",
            "title": "Paris"
          }
        ]
      }
    ]
  },
  "state": null
}
