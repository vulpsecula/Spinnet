          },
          "disk": {
            "total_bytes": 994662584320,
            "available_bytes": 556781801472
          },
          "battery": {
            "fraction": 0.78,
            "charging": false,
            "on_ac": true
          }
        }
      },
      {
        "result": {
          "cpu": {
            "user": 0.175,
            "system": 0.175,
            "busy": 0.35
          },
          "memory": {
            "total_bytes": 17179869184,
            "used_bytes": 12799754240,
            "compressed_bytes": 6185566208
          },
          "disk": {
            "total_bytes": 994662584320,
            "available_bytes": 556781801472
          },
          "battery": {
            "fraction": 0.78,
            "charging": false,
            "on_ac": true
          }
        }
      },
      {
        "result": {
          "cpu": {
            "user": 0.09,
            "system": 0.09,
            "busy": 0.18
          },
          "memory": {
            "total_bytes": 17179869184,
            "used_bytes": 12799754240,
            "compressed_bytes": 6185566208
          },
          "disk": {
            "total_bytes": 994662584320,
            "available_bytes": 556781801472
          },
          "battery": null
        }
      }
    ]
  },
  "steps": [
    {
      "start": "monitor.open",
      "script_answers": {
        "page": {
          "id": "monitor",
          "title": "System Monitor",
          "sources": [
            {
              "id": "metrics",
              "perform": "system.metrics",
              "input": {
                "metrics": [
                  "cpu",
                  "memory",
                  "disk",
                  "battery"
                ]
              },
              "every": 2
            }
          ],
          "content": [
            {
              "kind": "row",
              "id": "top",
              "content": [
                {
                  "kind": "text",
                  "id": "cpu",
                  "title": "CPU",
                  "text": "—",
                  "bind": {
                    "source": "metrics",
                    "pointer": "/cpu/busy",
                    "format": "percent"
                  }
                },
                {
                  "kind": "text",
                  "id": "memory",
                  "title": "Memory used",
                  "text": "—",
                  "bind": {
                    "source": "metrics",
                    "pointer": "/memory/used_bytes",
                    "format": "bytes"
                  }
                }
              ]
            },
            {
              "kind": "row",
              "id": "bottom",
              "content": [
                {
                  "kind": "text",
                  "id": "disk",
                  "title": "Disk available",
                  "text": "—",
                  "bind": {
                    "source": "metrics",
                    "pointer": "/disk/available_bytes",
                    "format": "bytes"
                  }
                },
                {
                  "kind": "text",
                  "id": "battery",
                  "title": "Battery",
                  "text": "—",
                  "bind": {
                    "source": "metrics",
                    "pointer": "/battery/fraction",
                    "format": "percent",
                    "unavailable": "No battery"
                  }
                }
              ]
            }
          ]
        },
        "state": {
          "view": "overview"
        }
      },
      "expect": {
        "samples_started_at": [
          0
        ],
        "shown": {
          "cpu": "21%",
          "battery": "78%"
        }
      }
    },
    {
      "advance": 2,
      "expect": {
        "samples_started_at": [
          0,
          2
        ],
        "shown": {
          "cpu": "35%"
        },
        "script_runs": 0
      }
    },
    {
      "advance": 2,
      "expect": {
        "shown": {
          "battery": "No battery"
        },
        "script_runs": 0
      }
    },
    {
      "advance": 31,
      "expect": {
        "helper_running": false,
        "samples_continue": true
      }
    }
  ]
}
