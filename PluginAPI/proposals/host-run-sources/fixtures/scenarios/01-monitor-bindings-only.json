{
  "manifest": {
    "api_level": 2
  },
  "description": "S2: a Monitor page shown by bindings alone. After the page's first answer no script runs, the helper retires, and the page keeps updating while visible.",
  "illustrative": true,
  "recordings": {
    "system.metrics": [
      {
        "result": {
          "cpu": {
