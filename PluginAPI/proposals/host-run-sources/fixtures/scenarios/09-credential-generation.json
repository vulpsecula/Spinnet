{
  "manifest": {
    "api_level": 2
  },
  "description": "Storing a credential the input references advances the Plugin's credential generation: sources referencing a credential start again with the new secret; the session stays open. (Level 1 sections today keep the old answer: see the README.)",
  "recordings": {
    "http.request": {
      "api.example.com": {
        "status": 200,
        "body": "{\"today\":{\"summary\":\"Sunny\"}}"
      }
    }
  },
  "credentials": {
    "example_key": "k1"
  },
  "steps": [
    {
      "start": "forecast.open",
      "script_answers": {
        "page": {
          "id": "forecast",
          "title": "Forecast",
          "sources": [
            {
              "id": "forecast",
              "perform": "http.request",
              "input": {
                "method": "GET",
                "url": "https://api.example.com/v1/forecast?city=Berlin",
                "credential_uses": [
                  {
                    "reference": "example_key",
                    "header": "Authorization",
                    "template": "Bearer {credential}"
                  }
                ]
              },
              "error_pointer": "/error/message",
              "status_messages": {
                "429": "The forecast service is busy"
              }
            }
          ],
          "content": [
            {
              "kind": "text",
              "id": "summary",
              "title": "Today",
              "text": "Loading…",
              "bind": {
                "source": "forecast",
                "pointer": "/json/today/summary"
              }
            },
            {
              "kind": "actions",
              "id": "buttons",
              "actions": [
                {
                  "id": "refresh",
                  "title": "Refresh"
                },
                {
                  "id": "paris",
                  "title": "Paris"
                }
              ]
            }
          ]
        },
        "state": null
      },
      "expect": {
        "requests": 1,
        "authorization_sent": [
          "Bearer k1"
        ]
      }
    },
    {
      "store_credential": {
        "example_key": "k2"
      },
      "expect": {
        "requests": 2,
        "authorization_sent": [
          "Bearer k1",
          "Bearer k2"
        ],
        "session_open": true
      }
    }
  ]
}
