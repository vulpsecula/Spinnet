{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spinnet Host-run sources (Plugin API Level 6 and later)",
  "$defs": {
    "sources": {
      "description": "Sampled only while the page is visible: its View Session open, the page on screen, its panel unoccluded, the user's session active and the displays awake.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "source": {
      "oneOf": [
        {
          "$ref": "sources-level-3.schema.json#/$defs/source"
        },
        {
          "$ref": "#/$defs/command_output_source"
        }
      ]
    },
    "command_output_source": {
      "description": "Once-only native Homebrew command output; every is refused.",
      "type": "object",
      "required": [
        "id",
        "perform",
        "input"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "sources-level-3.schema.json#/$defs/identifier"
        },
        "perform": {
          "const": "tools.read"
        },
        "input": {
          "$ref": "command-output.schema.json#/$defs/input"
        },
        "deliver": {
          "$ref": "sources-level-3.schema.json#/$defs/deliver"
        }
      }
    },
    "binding": {
      "$ref": "sources-level-3.schema.json#/$defs/binding"
    },
    "source_delivered": {
      "$ref": "sources-level-3.schema.json#/$defs/source_delivered"
    }
  }
}
