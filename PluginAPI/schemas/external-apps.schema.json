{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spinnet External App Host Services",
  "description": "Inputs and results of apps.perform and apps.openDeepLink. Scope, permissions, installed target, connection setup and gesture admission are additionally checked by the Host.",
  "$defs": {
    "perform_app_operation.input": {
      "description": "One operation of the Reviewed App Interface the Host ships for the application. The Host builds the one request the interface describes and sends it to the interface's handler; a Plugin cannot send AppleScript source, arbitrary Apple Events or another handler. Adding an application is a Host release.",
      "type": "object",
      "required": [
        "bundle_id",
        "operation"
      ],
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "description": "Exactly the operation's parameters.",
          "type": "object"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/reviewed_app_interfaces/$defs/com.hezongyidev.Bob"
        },
        {
          "$ref": "#/$defs/reviewed_app_interfaces/$defs/com.spotify.client"
        },
        {
          "$ref": "#/$defs/reviewed_app_interfaces/$defs/com.apple.Terminal"
        }
      ]
    },
    "perform_app_operation.result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "spotify.schema.json#/$defs/playback"
        },
        {
          "$ref": "spotify-controls.schema.json#/$defs/volume"
        },
        {
          "$ref": "spotify-controls.schema.json#/$defs/next_outcome"
        }
      ]
    },
    "reviewed_app_interfaces": {
      "description": "Every Reviewed App Interface this Host ships, keyed by bundle ID. Shape validation supplements Host scope, installation, connection and gesture checks.",
      "$defs": {
        "com.hezongyidev.Bob": {
          "description": "Bob, through its documented request handler. Every operation is in the translate family. Bob reads the selection, the screen, its own input window or the clipboard where an operation asks it to, and shows the result itself. Only translateText carries text: non-blank, at most 128 KiB of UTF-8.",
          "if": {
            "properties": {
              "bundle_id": {
                "const": "com.hezongyidev.Bob"
              }
            }
          },
          "then": {
            "properties": {
              "operation": {
                "enum": [
                  "selectionTranslate",
                  "snipTranslate",
                  "inputTranslate",
                  "pasteboardTranslate",
                  "translateText"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "translateText"
                    }
                  }
                },
                "then": {
                  "required": [
                    "arguments"
                  ],
                  "properties": {
                    "arguments": {
                      "required": [
                        "text"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "text": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "enum": [
                        "selectionTranslate",
                        "snipTranslate",
                        "inputTranslate",
                        "pasteboardTranslate"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "arguments": {
                      "maxProperties": 0
                    }
                  }
                }
              }
            ]
          }
        },
        "com.spotify.client": {
          "description": "Local Spotify playback and reviewed controls; all calls target the running App.",
          "if": {
            "properties": {
              "bundle_id": {
                "const": "com.spotify.client"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "$ref": "spotify.schema.json#/$defs/input"
              },
              {
                "$ref": "spotify-controls.schema.json#/$defs/input"
              }
            ]
          }
        },
        "com.apple.Terminal": {
          "description": "Typed Homebrew handoff through Terminal; execution requires a committed gesture-requested operation.",
          "if": {
            "properties": {
              "bundle_id": {
                "const": "com.apple.Terminal"
              }
            }
          },
          "then": {
            "properties": {
              "operation": {
                "const": "homebrew"
              },
              "arguments": {
                "$ref": "terminal-homebrew.schema.json"
              }
            },
            "required": [
              "arguments"
            ]
          }
        }
      }
    },
    "open_deep_link.input": {
      "description": "One of the Plugin's Deep Link Templates, by id, with exactly its parameters. A choice parameter takes one of its choices, written into the link as it is; a text parameter takes non-empty text of at most its max_length characters, percent-encoded. The Host checks that the declared application handles the scheme and opens the link without bringing it forward. A Command may open a template declaratively instead, with the deep_link.open Host Command, taking parameters from its configuration.",
      "type": "object",
      "required": [
        "template"
      ],
      "additionalProperties": false,
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "open_deep_link.result": {
      "type": "null"
    }
  }
}
