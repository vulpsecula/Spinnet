{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spinnet Plugin API namespaces (Plugin API Level 2)",
  "description": "Plugin API Level 2, promoted from Candidate Contract namespaces revision 1. The wire shapes of the Plugin API catalogue (../catalogue.json): each operation's input and result under its one ID, the IDs each entry point accepts, a call as the helper carries it, a page action that performs an operation and the input a performed operation takes (used by pages and Requested Host Operations), and a manifest Command that names an operation. A Level 2 Plugin names operations only by these IDs, except inside a Level 1 view (decision N5). Level 1's own shapes are unchanged and refuse every ID here; manifest.schema.json holds a Level 2 manifest's Commands to command below.",
  "$defs": {
    "text": {
      "description": "A string with at least one character that is not white space.",
      "type": "string",
      "pattern": "\\S"
    },
    "rect": {
      "description": "A rectangle in global points, origin at the top-left of the primary display.",
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "operation_id": {
      "description": "Every catalogue ID a Level 2 Plugin may name somewhere: exactly namespace.verb, two lowerCamelCase segments.",
      "enum": [
        "host.toast",
        "host.closeView",
        "host.showPluginSettings",
        "selection.readText",
        "selection.replace",
        "selection.copy",
        "selection.cut",
        "selection.paste",
        "keyboard.press",
        "clipboard.read",
        "clipboard.write",
        "clipboardHistory.read",
        "clipboardHistory.readContent",
        "clipboardHistory.show",
        "open.url",
        "open.path",
        "open.application",
        "apps.perform",
        "apps.openDeepLink",
        "system.runShortcut",
        "system.runService",
        "window.read",
        "window.setFrame",
        "window.toggleFullScreen",
        "window.restore",
        "screen.capture",
        "http.request",
        "text.detectLanguage",
        "storage.get",
        "storage.set",
        "storage.remove",
        "storage.keys",
        "storage.clear"
      ]
    },
    "call_id": {
      "description": "IDs a script may call: spinnet.<id>(input) or requestHostService(\"<id>\", input).",
      "enum": [
        "selection.readText",
        "selection.replace",
        "clipboard.read",
        "clipboard.write",
        "clipboardHistory.read",
        "clipboardHistory.readContent",
        "clipboardHistory.show",
        "open.url",
        "open.path",
        "open.application",
        "apps.perform",
        "apps.openDeepLink",
        "apps.frontmost",
        "window.read",
        "window.setFrame",
        "window.toggleFullScreen",
        "window.restore",
        "screen.capture",
        "http.request",
        "text.detectLanguage",
        "storage.get",
        "storage.set",
        "storage.remove",
        "storage.keys",
        "storage.clear"
      ]
    },
    "host_command_id": {
      "description": "IDs a manifest Command with execution host may name in host_command.",
      "enum": [
        "host.toast",
        "host.showPluginSettings",
        "selection.copy",
        "selection.cut",
        "selection.paste",
        "keyboard.press",
        "clipboard.write",
        "clipboardHistory.show",
        "open.url",
        "open.path",
        "open.application",
        "apps.perform",
        "apps.openDeepLink",
        "system.runShortcut",
        "system.runService",
        "window.toggleFullScreen",
        "window.restore",
        "screen.capture"
      ]
    },
    "view_action_id": {
      "description": "IDs a page action or item action may name in perform (collections).",
      "enum": [
        "host.showPluginSettings",
        "selection.replace",
        "clipboard.write",
        "clipboardHistory.show",
        "open.url",
        "open.path",
        "open.application",
        "apps.perform",
        "apps.openDeepLink",
        "apps.quit",
        "apps.close"
      ]
    },
    "item_action_id": {
      "description": "IDs an item action may perform on the item's text, which becomes the operation's primary member text.",
      "enum": [
        "selection.replace",
        "clipboard.write"
      ]
    },
    "request_id": {
      "description": "IDs an answer may request in operation.perform (host_operations).",
      "enum": [
        "host.showPluginSettings",
        "selection.replace",
        "clipboard.write",
        "clipboardHistory.show",
        "open.url",
        "open.path",
        "open.application",
        "apps.perform",
        "apps.openDeepLink",
        "apps.quit",
        "apps.close"
      ]
    },
    "app_target": {
      "description": "An App Target: the Host's opaque name for one running App, given by apps.frontmost to that Plugin only. It names that App until the App quits, the Plugin is updated, disabled or removed or loses a Capability, or Spinnet quits; a Plugin holds at most 16. It never contains the process ID.",
      "type": "string",
      "pattern": "^app_[0-9a-f]{32}$"
    },
    "app_exit": {
      "description": "close presses the App's own enabled ⌘W menu item, closing its front window as ⌘W does; quit presses its own enabled ⌘Q menu item, as ⌘Q or the Dock's Quit does; force_quit ends it at once.",
      "enum": [
        "close",
        "quit",
        "force_quit"
      ]
    },
    "host.toast.input": {
      "description": "The message: a string, or {text}.",
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "host.closeView.input": {
      "type": "null",
      "description": "No input."
    },
    "host.showPluginSettings.input": {
      "type": "null",
      "description": "No input."
    },
    "selection.readText.input": {
      "description": "null, or {best_effort: true} to answer null instead of failing when the selection cannot be read.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "best_effort"
          ],
          "additionalProperties": false,
          "properties": {
            "best_effort": {
              "const": true
            }
          }
        }
      ]
    },
    "selection.replace.input": {
      "description": "The text: a string, or {text}. At most 128 KiB of UTF-8, checked by the Host; empty text replaces the selection with nothing.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            }
          }
        }
      ]
    },
    "selection.copy.input": {
      "type": "null",
      "description": "No input."
    },
    "selection.cut.input": {
      "type": "null",
      "description": "No input."
    },
    "selection.paste.input": {
      "type": "null",
      "description": "No input."
    },
    "keyboard.press.input": {
      "description": "A key by name or by virtual key code, with modifiers. Level 1's string form and its alias member names stay Level 1's.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/text"
        },
        "key_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "modifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "command",
              "shift",
              "option",
              "control"
            ]
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "key"
          ],
          "properties": {
            "key_code": false
          }
        },
        {
          "required": [
            "key_code"
          ],
          "properties": {
            "key": false
          }
        }
      ]
    },
    "clipboard.read.input": {
      "type": "null",
      "description": "No input."
    },
    "clipboard.write.input": {
      "description": "The text: a string, or {text}.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            }
          }
        }
      ]
    },
    "clipboardHistory.read.input": {
      "description": "null for the newest page, or {offset}.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "offset"
          ],
          "additionalProperties": false,
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "clipboardHistory.readContent.input": {
      "type": "object",
      "required": [
        "entry_id",
        "offset",
        "length"
      ],
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 196608
        }
      }
    },
    "clipboardHistory.show.input": {
      "type": "null",
      "description": "No input."
    },
    "open.url.input": {
      "description": "The link: a string, or {url}. From a script, an action or a request it must be http or https with a host; a Command's configured link may have any scheme (design 6.2).",
      "oneOf": [
        {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 2048
        },
        {
          "type": "object",
          "required": [
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "\\S",
              "maxLength": 2048
            }
          }
        }
      ]
    },
    "open.path.input": {
      "description": "An absolute or ~/ path of at most 4096 UTF-8 bytes: a string, or {path}.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(/|~/)"
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(/|~/)"
            }
          }
        }
      ]
    },
    "open.application.input": {
      "description": "An application's path or bundle identifier: a string, or {application}.",
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "object",
          "required": [
            "application"
          ],
          "additionalProperties": false,
          "properties": {
            "application": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "apps.perform.input": {
      "$ref": "external-apps.schema.json#/$defs/perform_app_operation.input"
    },
    "apps.openDeepLink.input": {
      "$ref": "external-apps.schema.json#/$defs/open_deep_link.input"
    },
    "apps.frontmost.input": {
      "description": "apps.frontmost takes no input.",
      "type": "null"
    },
    "apps.quit.input": {
      "description": "The App to end and how. Without target, the App in front when the Host accepts the request (the answer commits or the page action is chosen); with one, the App that App Target names. force asks for Force Quit; otherwise the Host presses the App's own ⌘Q menu item, which needs Accessibility, and refuses an App whose menu has none. null is the App in front, quit gracefully. The Host asks a Host Confirmation naming the App for Force Quit and for an App not in front when it accepted the request; a graceful quit of the App in front then asks none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "$ref": "#/$defs/app_target"
            },
            "force": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "apps.close.input": {
      "description": "The App whose front window to close. Without target, the App in front when the Host accepts the request (the answer commits or the page action is chosen); with one, the App that App Target names. The Host presses the App's own ⌘W menu item, which needs Accessibility, and refuses an App whose menu has none enabled. The Host asks a Host Confirmation naming the App for an App not in front when it accepted the request; closing the App in front then asks none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "$ref": "#/$defs/app_target"
            }
          }
        }
      ]
    },
    "system.runShortcut.input": {
      "description": "The Shortcut's name: a string, or {name, input?} with text input.",
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/$defs/text"
            },
            "input": {
              "type": "string"
            }
          }
        }
      ]
    },
    "system.runService.input": {
      "description": "The Service's exact title in the Services menu, nested paths separated by /: a string, or {name, input?} with text input.",
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/$defs/text"
            },
            "input": {
              "type": "string"
            }
          }
        }
      ]
    },
    "window.read.input": {
      "type": "null",
      "description": "No input."
    },
    "window.setFrame.input": {
      "$ref": "#/$defs/rect",
      "description": "The new frame, in global points."
    },
    "window.toggleFullScreen.input": {
      "type": "null",
      "description": "No input."
    },
    "window.restore.input": {
      "type": "null",
      "description": "No input."
    },
    "screen.capture.input": {
      "description": "source alone, as a string or {source}, copies or saves as the user's screenshot preferences say (decision N9); otherwise copy_to_clipboard and save together, as Level 1's capture_screen, with at least one of them doing something and save.folder a folder the Action's configuration uses.",
      "oneOf": [
        {
          "enum": [
            "area",
            "fullscreen",
            "window"
          ]
        },
        {
          "type": "object",
          "required": [
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "area",
                "fullscreen",
                "window"
              ]
            },
            "copy_to_clipboard": {
              "type": "boolean"
            },
            "save": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "folder",
                    "format"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "folder": {
                      "$ref": "#/$defs/text"
                    },
                    "format": {
                      "enum": [
                        "automatic",
                        "png",
                        "jpg"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "copy_to_clipboard"
                ]
              },
              "then": {
                "required": [
                  "save"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "save"
                ]
              },
              "then": {
                "required": [
                  "copy_to_clipboard"
                ]
              }
            }
          ]
        }
      ]
    },
    "http.request.input": {
      "$ref": "https-request.schema.json#/$defs/https_request.input"
    },
    "text.detectLanguage.input": {
      "description": "The text: a string, or {text}.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            }
          }
        }
      ]
    },
    "storage.get.input": {
      "description": "The key: a string, or {key}.",
      "oneOf": [
        {
          "$ref": "plugin-storage.schema.json#/$defs/key"
        },
        {
          "type": "object",
          "required": [
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "plugin-storage.schema.json#/$defs/key"
            }
          }
        }
      ]
    },
    "storage.set.input": {
      "$ref": "plugin-storage.schema.json#/$defs/set_storage_value.input"
    },
    "storage.remove.input": {
      "description": "The key: a string, or {key}.",
      "oneOf": [
        {
          "$ref": "plugin-storage.schema.json#/$defs/key"
        },
        {
          "type": "object",
          "required": [
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "plugin-storage.schema.json#/$defs/key"
            }
          }
        }
      ]
    },
    "storage.keys.input": {
      "type": "null",
      "description": "No input."
    },
    "storage.clear.input": {
      "type": "null",
      "description": "No input."
    },
    "host.toast.result": {
      "type": "null"
    },
    "host.closeView.result": {
      "type": "null"
    },
    "host.showPluginSettings.result": {
      "type": "null"
    },
    "selection.readText.result": {
      "type": [
        "string",
        "null"
      ]
    },
    "selection.replace.result": {
      "type": "null"
    },
    "selection.copy.result": {
      "type": "null"
    },
    "selection.cut.result": {
      "type": "null"
    },
    "selection.paste.result": {
      "type": "null"
    },
    "keyboard.press.result": {
      "type": "null"
    },
    "clipboard.read.result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "text",
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "enum": [
                "text",
                "url"
              ]
            }
          }
        }
      ]
    },
    "clipboard.write.result": {
      "type": "null"
    },
    "clipboardHistory.read.result": {
      "type": "object",
      "required": [
        "state",
        "entries"
      ],
      "properties": {
        "state": {
          "enum": [
            "off",
            "paused",
            "collecting"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nextOffset": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAt": {
          "type": "number"
        }
      }
    },
    "clipboardHistory.readContent.result": {
      "type": "object",
      "required": [
        "data",
        "offset",
        "totalBytes"
      ],
      "properties": {
        "data": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "nextOffset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "clipboardHistory.show.result": {
      "type": "null"
    },
    "open.url.result": {
      "type": "null"
    },
    "open.path.result": {
      "type": "null"
    },
    "open.application.result": {
      "type": "null"
    },
    "apps.perform.result": {
      "type": "null"
    },
    "apps.openDeepLink.result": {
      "type": "null"
    },
    "apps.frontmost.result": {
      "description": "The App in front, or null while Spinnet or no App is in front, or an App whose launch date and process start time the Host cannot read, which it cannot tell from a later App with its process ID (Finder, which has no launch date, is identified by its process start time). exits lists what apps.close and apps.quit would do to it now: close and quit when its own menu has an enabled ⌘W or ⌘Q item and Spinnet has Accessibility, force_quit for any regular App; an empty list means the Host performs no exit on it.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "target",
            "name",
            "bundle_id",
            "exits"
          ],
          "additionalProperties": false,
          "properties": {
            "target": {
              "$ref": "#/$defs/app_target"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "bundle_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "exits": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/app_exit"
              }
            }
          }
        }
      ]
    },
    "apps.quit.result": {
      "description": "Nothing: the outcome is operation_finished's.",
      "type": "null"
    },
    "apps.close.result": {
      "description": "Nothing: the outcome is operation_finished's.",
      "type": "null"
    },
    "system.runShortcut.result": {
      "type": "null"
    },
    "system.runService.result": {
      "type": "null"
    },
    "window.read.result": {
      "type": "object",
      "required": [
        "frame",
        "visibleFrame",
        "displays",
        "displayIndex"
      ],
      "properties": {
        "frame": {
          "$ref": "#/$defs/rect"
        },
        "visibleFrame": {
          "$ref": "#/$defs/rect"
        },
        "displays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rect"
          }
        },
        "displayIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "window.setFrame.result": {
      "type": "null"
    },
    "window.toggleFullScreen.result": {
      "type": "null"
    },
    "window.restore.result": {
      "type": "null"
    },
    "screen.capture.result": {
      "type": "null"
    },
    "http.request.result": {
      "$ref": "https-request.schema.json#/$defs/https_request.result"
    },
    "text.detectLanguage.result": {
      "type": [
        "string",
        "null"
      ]
    },
