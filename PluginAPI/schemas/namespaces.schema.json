    "command": {
      "description": "A Level 2 manifest Command: Level 1's Command, with host_command naming a catalogue ID and an optional fixed input. The Host also checks what a shape cannot say: input's members belong to the operation's input and no configuration field supplies one of them again; the Action's input, merged with input, satisfies the operation's input definition.",
      "type": "object",
      "required": [
        "id",
        "title",
        "execution"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "manifest.schema.json#/$defs/text"
        },
        "title": {
          "$ref": "manifest.schema.json#/$defs/text"
        },
        "description": {
          "$ref": "manifest.schema.json#/$defs/text"
        },
        "execution": {
          "enum": [
            "host",
            "javascript"
          ]
        },
        "is_configurable": {
          "type": "boolean"
        },
        "host_command": {
          "$ref": "#/$defs/host_command_id"
        },
        "input": {
          "description": "Members of the operation's input fixed by the Command, such as screen.capture's source; the Action's configured input supplies the rest.",
          "type": "object"
        },
        "script": {
          "$ref": "manifest.schema.json#/$defs/scriptPath"
        },
        "configuration_field": {
          "$ref": "manifest.schema.json#/$defs/field"
        },
        "configuration_fields": {
          "type": "array",
          "items": {
            "$ref": "manifest.schema.json#/$defs/field"
          }
        },
        "deep_link_template": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "execution"
            ],
            "properties": {
              "execution": {
                "const": "host"
              }
            }
          },
          "then": {
            "required": [
              "host_command"
            ],
            "properties": {
              "script": false
            }
          }
        },
        {
          "if": {
            "required": [
              "execution"
            ],
            "properties": {
              "execution": {
                "const": "javascript"
              }
            }
          },
          "then": {
            "required": [
              "script"
            ],
            "properties": {
              "host_command": false,
              "input": false,
              "deep_link_template": false
            }
          }
        },
        {
          "if": {
            "required": [
              "host_command"
            ],
            "properties": {
              "host_command": {
                "const": "apps.openDeepLink"
              }
            }
          },
          "then": {
            "required": [
              "deep_link_template"
            ]
          }
        },
        {
          "if": {
            "required": [
              "host_command"
            ],
            "properties": {
              "host_command": {
                "const": "screen.capture"
              }
            }
          },
          "then": {
            "required": [
              "input"
            ],
            "properties": {
              "input": {
                "required": [
                  "source"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "host_command"
            ],
            "properties": {
              "host_command": {
                "const": "apps.perform"
              }
            }
          },
          "then": {
            "required": [
              "input"
            ],
            "properties": {
              "input": {
                "required": [
                  "bundle_id",
                  "operation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "deep_link_template"
            ]
          },
          "then": {
            "required": [
              "host_command"
            ],
            "properties": {
              "host_command": {
                "const": "apps.openDeepLink"
              }
            }
          }
        }
      ]
    }
