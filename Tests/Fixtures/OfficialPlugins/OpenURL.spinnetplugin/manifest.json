{
  "protocol_version": "1.0",
  "engines": {"spinnet": "^1.0.0"},
  "id": "com.spinnet.builtin.open-url",
  "name": "Open URL",
  "version": "1.0.1",
  "preset": {
    "readiness": "setup_required",
    "is_configurable": true,
    "default_primary_command_id": "builtin.open_url"
  },
  "commands": [
    {
      "id": "builtin.open_url",
      "title": "Open URL",
      "execution": "host",
      "is_configurable": true,
      "host_command": "open.url",
      "configuration_field": {
        "kind": "url",
        "title": "URL",
        "placeholder": "https://example.com"
      }
    }
  ]
}
