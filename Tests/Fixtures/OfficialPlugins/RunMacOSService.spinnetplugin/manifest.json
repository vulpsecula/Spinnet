{
  "protocol_version": "1.0",
  "engines": {"spinnet": "^1.0.0"},
  "id": "com.spinnet.builtin.service",
  "name": "Run macOS Service",
  "version": "1.0.0",
  "preset": {
    "readiness": "setup_required",
    "is_configurable": true,
    "default_primary_command_id": "builtin.run_service"
  },
  "commands": [
    {
      "id": "builtin.run_service",
      "title": "Run macOS Service",
      "execution": "host",
      "is_configurable": true,
      "host_command": "system.runService",
      "configuration_field": {
        "kind": "text",
        "title": "macOS Service",
        "placeholder": "Exact title from the active app's Services menu"
      }
    }
  ]
}
