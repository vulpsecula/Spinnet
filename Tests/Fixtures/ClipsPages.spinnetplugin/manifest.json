{
  "protocol_version": "1.0",
  "id": "com.example.clips-pages",
  "name": "Clips Pages",
  "version": "1.0.0",
  "capabilities": [
    "insert_into_focused_app",
    "write_clipboard"
  ],
  "capability_scopes": [
    {
      "capability": "insert_into_focused_app",
      "command_ids": [
        "clips.list"
      ],
      "data_types": [
        "text"
      ],
      "includes_existing_host_data": false,
      "https_hosts": [],
      "external_apps": []
    }
  ],
  "preset": {
    "readiness": "ready_to_use",
    "is_configurable": false,
    "default_primary_command_id": "clips.list",
    "default_alternate_command_ids": []
  },
  "commands": [
    {
      "id": "clips.list",
      "title": "Clips",
      "description": "Lists saved snippets in a list with multiple selection: open, pin, remove, rename, copy or insert several at once.",
      "execution": "javascript",
      "is_configurable": false,
      "script": "clips.js"
    }
  ],
  "engines": {
    "spinnet": "^1.0.0"
  }
}
