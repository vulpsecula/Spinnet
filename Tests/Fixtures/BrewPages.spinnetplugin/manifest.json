{
  "protocol_version": "1.0",
  "api_level": 1,
  "candidate_contracts": [
    {"name": "collections", "revision": 3},
    {"name": "host_operations", "revision": 2},
    {"name": "namespaces", "revision": 1}
  ],
  "id": "com.example.brew-pages",
  "name": "Brew Pages",
  "version": "2.0.0",
  "capabilities": ["write_clipboard", "open_url"],
  "settings_fields": [
    {"key": "scope", "kind": "choice", "title": "Show", "choices": ["installed", "outdated", "all"],
     "choice_titles": ["Installed", "Outdated", "All"], "overridable": true}
  ],
  "default_settings": {"scope": "installed"},
  "preset": {
    "readiness": "ready_to_use",
    "is_configurable": false,
    "default_primary_command_id": "brew.packages",
    "default_alternate_command_ids": []
  },
  "commands": [
    {
      "id": "brew.packages",
      "title": "Homebrew Packages",
      "description": "Lists Homebrew-shaped packages, pages through a search, and shows a package's details.",
      "execution": "javascript",
      "is_configurable": false,
      "script": "brew.js"
    }
  ]
}
