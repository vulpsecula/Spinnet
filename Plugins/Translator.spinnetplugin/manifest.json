{
  "protocol_version": "1.0",
  "id": "com.spinnet.translator",
  "name": "Translator",
  "version": "2.0.0",
  "capabilities": ["read_selected_text", "read_current_clipboard", "contact_https"],
  "capability_scopes": [{
    "capability": "read_selected_text",
    "command_ids": ["translator.selection"],
    "data_types": ["text"], "includes_existing_host_data": false, "https_hosts": [], "external_apps": []
  }, {
    "capability": "read_current_clipboard",
    "command_ids": ["translator.clipboard"],
    "data_types": ["text"], "includes_existing_host_data": false, "https_hosts": [], "external_apps": []
  }, {
    "capability": "contact_https",
    "command_ids": ["translator.selection", "translator.input", "translator.clipboard"],
    "data_types": ["text"], "includes_existing_host_data": false,
    "https_hosts": ["api-free.deepl.com", "api.deepl.com", "translation.googleapis.com", "api.openai.com"], "external_apps": []
  }],
  "settings_fields": [
    {"key": "sources", "kind": "ordered_choices", "title": "Sources", "choices": ["DeepL", "Google", "OpenAI"]},
    {"key": "target_language", "kind": "choice", "title": "Translate Into", "overridable": true,
     "choices": ["EN-US", "EN-GB", "DE", "FR", "ES", "IT", "NL", "PL", "PT-BR", "PT-PT", "RU", "SV", "DA", "FI", "CS", "UK", "TR", "AR", "ID", "JA", "KO", "ZH-HANS", "ZH-HANT"]},
    {"key": "deepl_endpoint", "kind": "https_endpoint", "title": "DeepL Endpoint", "placeholder": "https://api-free.deepl.com",
     "used_when": {"key": "sources", "values": ["DeepL"]}},
    {"key": "deepl_credential", "kind": "credential", "title": "DeepL API Key", "placeholder": "DeepL authentication key",
     "used_when": {"key": "sources", "values": ["DeepL"]}},
    {"key": "formality", "kind": "choice", "title": "DeepL Formality", "overridable": true,
     "choices": ["default", "prefer_more", "prefer_less"], "used_when": {"key": "sources", "values": ["DeepL"]}},
    {"key": "google_credential", "kind": "credential", "title": "Google API Key", "placeholder": "Cloud Translation API key",
     "used_when": {"key": "sources", "values": ["Google"]}},
    {"key": "openai_endpoint", "kind": "https_endpoint", "title": "OpenAI Base URL", "placeholder": "https://api.openai.com/v1",
     "used_when": {"key": "sources", "values": ["OpenAI"]}},
    {"key": "openai_model", "kind": "text", "title": "OpenAI Model", "placeholder": "gpt-4.1-mini",
     "used_when": {"key": "sources", "values": ["OpenAI"]}},
    {"key": "openai_credential", "kind": "credential", "title": "OpenAI API Key", "placeholder": "API key for the base URL",
     "used_when": {"key": "sources", "values": ["OpenAI"]}}
  ],
  "default_settings": {
    "sources": ["DeepL"],
    "target_language": "EN-US",
    "deepl_endpoint": "https://api-free.deepl.com",
    "deepl_credential": "deepl",
    "formality": "default",
    "google_credential": "google",
    "openai_endpoint": "https://api.openai.com/v1",
    "openai_model": "gpt-4.1-mini",
    "openai_credential": "openai"
  },
  "preset": {
    "readiness": "ready_to_use",
    "is_configurable": true,
    "default_primary_command_id": "translator.selection",
    "default_alternate_command_ids": ["translator.input", "translator.clipboard"],
    "default_inputs": {"translator.selection": {}, "translator.input": {}, "translator.clipboard": {}}
  },
  "commands": [{
    "id": "translator.selection",
    "title": "Translate Selection",
    "description": "Translates the selected text with every source turned on and shows the results in a popup.",
    "execution": "javascript",
    "is_configurable": true,
    "script": "translate.js"
  }, {
    "id": "translator.input",
    "title": "Translate Input",
    "description": "Opens the translation popup with a field to type in, then translates what you enter.",
    "execution": "javascript",
    "is_configurable": true,
    "script": "translate.js"
  }, {
    "id": "translator.clipboard",
    "title": "Translate Clipboard",
    "description": "Translates the text on the clipboard with every source turned on and shows the results in a popup.",
    "execution": "javascript",
    "is_configurable": true,
    "script": "translate.js"
  }]
}
