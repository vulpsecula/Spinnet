{
  "protocol_version": "1.0",
  "api_level": 1,
  "id": "com.spinnet.bob",
  "name": "Bob",
  "version": "1.1.0",
  "capabilities": ["control_external_app", "read_selected_text", "read_current_clipboard"],
  "optional_capabilities": ["read_current_clipboard"],
  "capability_scopes": [{
    "capability": "control_external_app",
    "command_ids": [
      "bob.selection_translate",
      "bob.snip_translate",
      "bob.input_translate",
      "bob.pasteboard_translate",
      "bob.translate_text"
    ],
    "data_types": [],
    "includes_existing_host_data": false,
    "https_hosts": [],
    "external_apps": [{
      "bundle_id": "com.hezongyidev.Bob",
      "operation_families": ["translate"]
    }]
  }, {
    "capability": "read_selected_text",
    "command_ids": ["bob.selection_translate"],
    "data_types": ["text"], "includes_existing_host_data": false, "https_hosts": [], "external_apps": []
  }, {
    "capability": "read_current_clipboard",
    "command_ids": ["bob.selection_translate"],
    "data_types": ["text"], "includes_existing_host_data": false, "https_hosts": [], "external_apps": []
  }],
  "preset": {
    "readiness": "ready_to_use",
    "is_configurable": true,
    "default_primary_command_id": "bob.selection_translate",
    "default_alternate_command_ids": [
      "bob.input_translate",
      "bob.pasteboard_translate",
      "bob.snip_translate"
    ]
  },
  "commands": [{
    "id": "bob.selection_translate",
    "title": "Translate Selection with Bob",
    "description": "Reads the selection and asks Bob to translate it. With nothing selected, opens Bob's input window; when Spinnet cannot read the selection, Bob reads it itself.",
    "execution": "javascript",
    "is_configurable": false,
    "script": "translate.js"
  }, {
    "id": "bob.snip_translate",
    "title": "Capture and Translate with Bob",
    "description": "Asks Bob to capture a screen region and display its translation.",
    "execution": "javascript",
    "is_configurable": false,
    "script": "translate.js"
  }, {
    "id": "bob.input_translate",
    "title": "Translate Input with Bob",
    "description": "Opens Bob's input window so you can enter text for translation.",
    "execution": "javascript",
    "is_configurable": false,
    "script": "translate.js"
  }, {
    "id": "bob.pasteboard_translate",
    "title": "Translate Clipboard with Bob",
    "description": "Asks Bob to read the clipboard and display its translation.",
    "execution": "javascript",
    "is_configurable": false,
    "script": "translate.js"
  }, {
    "id": "bob.translate_text",
    "title": "Translate Configured Text with Bob",
    "description": "Sends the configured text to Bob, which displays the translation.",
    "execution": "javascript",
    "is_configurable": true,
    "script": "translate.js",
    "configuration_field": {
      "kind": "multiline_text",
      "title": "Text",
      "placeholder": "Text for Bob to translate"
    }
  }]
}
